---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { profile } from "../data/profile";
import { url } from "../lib/url";

const featured = (await getCollection("projects", ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <section class="hero">
    <p class="eyebrow mono">{profile.name_zh} · {profile.name}</p>
    <h1>{profile.title}</h1>
    <p class="lead">{profile.tagline}</p>
    <div class="hero-actions">
      <a class="btn primary" href={url("projects/")}>View Projects</a>
      <a class="btn" href={url("about/")}>About Me</a>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">01</span> Introduction</h2>
    <div class="prose-block">
      {profile.intro.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">02</span> Selected Projects</h2>
    <p class="muted section-note">三個專案屬於同一套系統：先建資料底層，再往上做風控與營運自動化。</p>
    <div class="project-grid">
      {featured.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">03</span> Core Capabilities</h2>
    <ul class="capability-grid">
      {profile.capabilities.map((c) => (
        <li>
          <h3 class="mono">{c.name}</h3>
          <p>{c.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="contact">
    <h2 class="section-title"><span class="mono">04</span> Contact</h2>
    <ContactLinks />
  </section>
</Base>
