---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
---

<Base title="About">
  <section class="page-head">
    <p class="eyebrow mono">About</p>
    <h1>{profile.name}</h1>
    <p class="lead">{profile.tagline}</p>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">01</span> Background</h2>
    <div class="prose-block">
      {profile.intro.map((p) => <p>{p}</p>)}
    </div>
    <ol class="timeline">
      {profile.experience.map((e) => (
        <li>
          <span class="mono muted">{e.period}</span>
          <div>
            <h3>{e.company}</h3>
            <p class="muted">{e.role}</p>
            <p>{e.note}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="muted small">{profile.education}</p>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">02</span> Core Capabilities</h2>
    <ul class="capability-grid">
      {profile.capabilities.map((c) => (
        <li>
          <h3 class="mono">{c.name}</h3>
          <p>{c.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">03</span> Engineering Philosophy</h2>
    <div class="principle-list">
      {profile.philosophy.map((item) => (
        <div class="principle">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">04</span> Problem-solving Approach</h2>
    <ol class="approach">
      {profile.approach.map((a, i) => (
        <li>
          <span class="approach-step mono">{String(i + 1).padStart(2, "0")} {a.step}</span>
          <div>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
            <p class="muted small">例：{a.example}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>
