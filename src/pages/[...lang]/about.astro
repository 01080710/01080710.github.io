---
import Base from "../../layouts/Base.astro";
import CareerBar from "../../components/CareerBar.astro";
import { get_profile } from "../../i18n/profile";
import { lang_from_param, lang_static_paths, use_translations } from "../../i18n/ui";
import { format_duration } from "../../lib/career-period";
import { url } from "../../lib/url";

export const getStaticPaths = lang_static_paths;

const lang    = lang_from_param(Astro.params.lang);
const profile = get_profile(lang);
const t       = use_translations(lang);
---

<Base title="About" lang={lang}>
  <section class="page-head">
    <p class="eyebrow mono">About</p>
    <h1>{profile.name}</h1>
    <p class="lead">{profile.tagline}</p>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">01</span> Background</h2>
    <div class="prose-block">
      {profile.intro.map((p) => <p>{p}</p>)}
    </div>
    <script is:inline>
      // Opt in to the entrance animation before the career bar and timeline are parsed, so they never flash
      // fully drawn first. Without JS, or with reduced motion, everything stays static and fully visible.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion-ok");
    </script>
    <CareerBar experience={profile.experience} label={profile.career_label} lang={lang} />
    <ol class="timeline">
      {profile.experience.map((e) => (
        <li class={e.end ? "" : "is-current"}>
          <div class="timeline-when">
            <span class="mono">{e.start} – {e.end || t("about.present")}</span>
            <span class="muted small">{format_duration(e.start, e.end, lang)}</span>
          </div>
          <div class="timeline-body">
            <div class="timeline-head">
              <h3>{e.company}</h3>
              <span class="timeline-role">{e.role}</span>
              {!e.end && <span class="timeline-current">{t("about.current")}</span>}
            </div>
            <p>{e.note}</p>
            <ul class="timeline-tags">
              {e.tags.map((tag, i) => <li style={`--i:${i}`}>{tag}</li>)}
            </ul>
          </div>
        </li>
      ))}
      <li class="is-education">
        <div class="timeline-when">
          <span class="mono">{profile.education.period}</span>
          <span class="muted small mono">EDUCATION</span>
        </div>
        <div class="timeline-body">
          <h3>{profile.education.school}</h3>
          <p class="muted">{profile.education.note}</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">02</span> Core Capabilities</h2>
    <ul class="capability-grid">
      {profile.capabilities.map((c) => (
        <li>
          <h3 class="mono">{c.name}</h3>
          <p>{c.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">03</span> Engineering Philosophy</h2>
    <div class="principle-list">
      {profile.philosophy.map((item) => (
        <div class="principle">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">04</span> Problem-solving Approach</h2>
    <ol class="approach">
      {profile.approach.map((a, i) => (
        <li>
          <span class="approach-step mono">{String(i + 1).padStart(2, "0")} {a.step}</span>
          <div>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
            <p class="muted small">{t("about.example")}{a.example}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="off-the-clock">
    <h2 class="section-title"><span class="mono">05</span> Off the Clock</h2>
    <p class="prose-block">{profile.life.intro}</p>
    <ul class="life-gallery">
      {profile.life.photos.map((photo, i) => (
        <li class={i === 0 ? "is-wide" : ""}>
          <figure>
            <img src={url(photo.src)} alt={photo.alt} loading="lazy" decoding="async"
                 width={i === 0 ? 1600 : 1000} height={i === 0 ? 900 : 750} />
            <figcaption><span class="mono">{photo.place}</span> {photo.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  // About entrance: the career bar assembles once when it scrolls into view (segments grow, tenure counts up);
  // the timeline's line follows scroll progress and reveals each job as the line reaches it. Plays once.
  import { format_months } from "../../lib/career-period";
  import type { Lang } from "../../i18n/ui";

  const COUNT_MS  = 1200;   // keep in step with SWEEP_S in CareerBar.astro
  const BAR_AT    = 0.85;   // start the bar when its top passes 85% of the viewport height
  const LINE_AT   = 0.65;   // the timeline line's tip sits at 65% of the viewport height

  const root     = document.documentElement;
  const bar      = document.querySelector<HTMLElement>(".career-bar");
  const timeline = document.querySelector<HTMLElement>(".timeline");

  function count_up(el: SVGTextElement) {
    const total = Number(el.dataset.countTotal), label = el.dataset.countLabel ?? "";
    const lang  = (el.dataset.countLang ?? "zh") as Lang;
    const start = performance.now();
    const frame = (now: number) => {
      const p = Math.min((now - start) / COUNT_MS, 1);
      const months = Math.round(total * (1 - Math.pow(1 - p, 3)));   // ease-out: fast start, settles on the total
      el.textContent = `${label} · ${format_months(months, lang) || "0"}`;
      if (p < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  function update() {
    const vh = window.innerHeight;
    if (bar && !bar.classList.contains("is-in") && bar.getBoundingClientRect().top < vh * BAR_AT) {
      bar.classList.add("is-in");
      const counter = bar.querySelector<SVGTextElement>("[data-count-total]");
      if (counter) count_up(counter);
    }
    if (timeline) {
      const rect = timeline.getBoundingClientRect();
      const tip  = vh * LINE_AT - rect.top;
      timeline.style.setProperty("--progress", String(Math.min(Math.max(tip / rect.height, 0), 1)));
      timeline.querySelectorAll<HTMLElement>(":scope > li:not(.is-in)").forEach((li) => {
        if (li.offsetTop + 12 <= tip) li.classList.add("is-in");
      });
    }
  }

  if (root.classList.contains("motion-ok")) {
    let queued = false;
    const on_scroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    };
    window.addEventListener("scroll", on_scroll, { passive: true });
    window.addEventListener("resize", on_scroll);
    update();
  }
</script>
