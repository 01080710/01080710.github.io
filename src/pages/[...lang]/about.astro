---
import Base from "../../layouts/Base.astro";
import CareerBar from "../../components/CareerBar.astro";
import { get_profile } from "../../i18n/profile";
import { lang_from_param, lang_static_paths, use_translations } from "../../i18n/ui";
import { format_duration } from "../../lib/career-period";
import { url } from "../../lib/url";

export const getStaticPaths = lang_static_paths;

const lang    = lang_from_param(Astro.params.lang);
const profile = get_profile(lang);
const t       = use_translations(lang);

// Off the Clock reads top to bottom as one descent: sky -> sea level -> underwater. Each photo's zone is set in
// profile.ts; photos keep their data order inside a zone. No altitudes or depths are shown (Peter's choice).
const ZONES = ["sky", "surface", "underwater"] as const;
const life_zones = ZONES.map((zone) => ({
  zone,
  photos: profile.life.photos.map((photo, i) => ({ ...photo, i })).filter((photo) => photo.zone === zone),
})).filter((z) => z.photos.length);
---

<Base title="About" lang={lang}>
  <section class="page-head">
    <p class="eyebrow mono">About</p>
    <h1>{profile.name}</h1>
    <p class="lead">{profile.tagline}</p>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">01</span> Background</h2>
    <div class="prose-block">
      {profile.intro.map((p) => <p>{p}</p>)}
    </div>
    <script is:inline>
      // Opt in to the entrance animation before the career bar and timeline are parsed, so they never flash
      // fully drawn first. Without JS, or with reduced motion, everything stays static and fully visible.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion-ok");
    </script>
    <CareerBar experience={profile.experience} label={profile.career_label} lang={lang} />
    <ol class="timeline">
      {profile.experience.map((e) => (
        <li class={e.end ? "" : "is-current"}>
          <div class="timeline-when">
            <span class="mono">{e.start} – {e.end || t("about.present")}</span>
            <span class="muted small">{format_duration(e.start, e.end, lang)}</span>
          </div>
          <div class="timeline-body">
            <div class="timeline-head">
              <h3>{e.company}</h3>
              <span class="timeline-role">{e.role}</span>
              {!e.end && <span class="timeline-current">{t("about.current")}</span>}
            </div>
            <p>{e.note}</p>
            <ul class="timeline-tags">
              {e.tags.map((tag, i) => <li style={`--i:${i}`}>{tag}</li>)}
            </ul>
          </div>
        </li>
      ))}
      <li class="is-education">
        <div class="timeline-when">
          <span class="mono">{profile.education.period}</span>
          <span class="muted small mono">EDUCATION</span>
        </div>
        <div class="timeline-body">
          <h3>{profile.education.school}</h3>
          <p class="muted">{profile.education.note}</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="section" id="certifications">
    <h2 class="section-title"><span class="mono">02</span> Certifications</h2>
    <p class="muted small">{t("about.certs_note")}</p>
    {profile.certifications.map((group) => (
      <div class="cert-group">
        <h3 class="cert-group-title mono">{group.group}</h3>
        <ul class="cert-grid">
          {group.items.map((c) => (
            <li>
              {/* Plain link to the masked full-size scan: works without JS and opens in a new tab. */}
              <a class="cert-card" href={url(c.image)} target="_blank" rel="noopener">
                <span class="cert-thumb">
                  <img src={url(c.image.replace(/\.jpg$/, "-thumb.jpg"))} alt="" loading="lazy" decoding="async" />
                </span>
                <span class="cert-text">
                  <span class="cert-name">{c.name}</span>
                  <span class="cert-meta muted small">{c.issuer} <span class="mono">{c.date}</span></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">03</span> Core Capabilities</h2>
    <ul class="capability-grid">
      {profile.capabilities.map((c) => (
        <li>
          <h3 class="mono">{c.name}</h3>
          <p>{c.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">04</span> Engineering Philosophy</h2>
    <div class="principle-list">
      {profile.philosophy.map((item) => (
        <div class="principle">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title"><span class="mono">05</span> Problem-solving Approach</h2>
    <ol class="approach">
      {profile.approach.map((a, i) => (
        <li>
          <span class="approach-step mono">{String(i + 1).padStart(2, "0")} {a.step}</span>
          <div>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
            {a.example && <p class="muted small">{t("about.example")}{a.example}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="off-the-clock">
    <h2 class="section-title"><span class="mono">06</span> Off the Clock</h2>
    <p class="prose-block">{profile.life.intro}</p>
    <div class="life-depth">
      {life_zones.map((z) => (
        <div class={`life-zone zone-${z.zone}`} data-zone={z.zone}>
          {z.zone === "surface" && (
            <svg class="life-sea" viewBox="0 0 240 12" preserveAspectRatio="none" aria-hidden="true">
              <path d="M0 6 Q15 0 30 6 T60 6 T90 6 T120 6 T150 6 T180 6 T210 6 T240 6" />
            </svg>
          )}
          <p class="life-zone-label mono"><span>{t(`about.zone_${z.zone}`)}</span></p>
          <ul class="life-gallery">
            {z.photos.map((photo) => (
              <li class={photo.i === 0 || photo.video ? "is-wide" : ""}>
                <figure>
                  {photo.video ? (
                    /* Controls by default so it works without JS; the script below swaps them for muted autoplay. */
                    <video class="life-video" src={url(photo.video)} poster={url(photo.src)} aria-label={photo.alt}
                           controls muted loop playsinline preload="none" width="1280" height="720"></video>
                  ) : (
                    <img src={url(photo.src)} alt={photo.alt} loading="lazy" decoding="async"
                         width={photo.i === 0 ? 1600 : 1000} height={photo.i === 0 ? 900 : 750} />
                  )}
                  <figcaption><span class="mono">{photo.place}</span> {photo.caption}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
          {z.zone === "underwater" && (
            <p class="life-cert small">
              <span class="muted">{profile.life.cert.label}</span> {profile.life.cert.name}
              <span class="mono muted">{profile.life.cert.date}</span>
              <a href={url(profile.life.cert.image)} target="_blank" rel="noopener">{t("about.cert_view")} →</a>
            </p>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>

<script>
  // Life video: muted loop that plays only while on screen; visitors who prefer reduced motion keep the controls.
  const life_videos = document.querySelectorAll<HTMLVideoElement>(".life-video");
  if (life_videos.length && !matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => { v.controls = true; });
        else v.pause();
      }
    }, { threshold: 0.4 });
    life_videos.forEach((v) => { v.controls = false; v.preload = "auto"; io.observe(v); });
  }
</script>

<script>
  // About entrance: the career bar assembles once when it scrolls into view (segments grow, tenure counts up);
  // the timeline's line follows scroll progress and reveals each job as the line reaches it. Plays once.
  import { format_months } from "../../lib/career-period";
  import type { Lang } from "../../i18n/ui";

  const COUNT_MS  = 1200;   // keep in step with SWEEP_S in CareerBar.astro
  const BAR_AT    = 0.85;   // start the bar when its top passes 85% of the viewport height
  const LINE_AT   = 0.65;   // the timeline line's tip sits at 65% of the viewport height

  const root     = document.documentElement;
  const bar      = document.querySelector<HTMLElement>(".career-bar");
  const timeline = document.querySelector<HTMLElement>(".timeline");

  function count_up(el: SVGTextElement) {
    const total = Number(el.dataset.countTotal), label = el.dataset.countLabel ?? "";
    const lang  = (el.dataset.countLang ?? "zh") as Lang;
    const start = performance.now();
    const frame = (now: number) => {
      const p = Math.min((now - start) / COUNT_MS, 1);
      const months = Math.round(total * (1 - Math.pow(1 - p, 3)));   // ease-out: fast start, settles on the total
      el.textContent = `${label} · ${format_months(months, lang) || "0"}`;
      if (p < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  function update() {
    const vh = window.innerHeight;
    if (bar && !bar.classList.contains("is-in") && bar.getBoundingClientRect().top < vh * BAR_AT) {
      bar.classList.add("is-in");
      const counter = bar.querySelector<SVGTextElement>("[data-count-total]");
      if (counter) count_up(counter);
    }
    if (timeline) {
      const rect = timeline.getBoundingClientRect();
      const tip  = vh * LINE_AT - rect.top;
      timeline.style.setProperty("--progress", String(Math.min(Math.max(tip / rect.height, 0), 1)));
      timeline.querySelectorAll<HTMLElement>(":scope > li:not(.is-in)").forEach((li) => {
        if (li.offsetTop + 12 <= tip) li.classList.add("is-in");
      });
    }
  }

  // Off the Clock: the depth gauge fills with scroll, the zone in view lights its label, photos settle in once.
  const depth = document.querySelector<HTMLElement>(".life-depth");
  function update_depth() {
    if (!depth) return;
    const vh = window.innerHeight, rect = depth.getBoundingClientRect();
    // The section sits just above the footer, so the line's tip can never reach its bottom by scrolling alone:
    // map the scroll range [tip meets the top, tip meets the bottom or the page ends] onto 0..1.
    const top_y   = window.scrollY + rect.top;
    const start_y = top_y - vh * LINE_AT;
    const end_y   = Math.min(top_y + rect.height - vh * LINE_AT, document.documentElement.scrollHeight - vh);
    const progress = Math.min(Math.max((window.scrollY - start_y) / Math.max(end_y - start_y, 1), 0), 1);
    depth.style.setProperty("--progress", String(progress));
    const tip = progress * rect.height;
    depth.querySelectorAll<HTMLElement>(".life-zone").forEach((zone) => {
      const top = zone.offsetTop, bottom = top + zone.offsetHeight;
      zone.classList.toggle("is-current", tip >= top && (tip < bottom || (progress === 1 && !zone.nextElementSibling)));
    });
    depth.querySelectorAll<HTMLElement>(".life-gallery > li:not(.is-in)").forEach((li) => {
      if (li.getBoundingClientRect().top < vh * 0.9) li.classList.add("is-in");
    });
  }

  if (root.classList.contains("motion-ok")) {
    let queued = false;
    const on_scroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); update_depth(); });
    };
    window.addEventListener("scroll", on_scroll, { passive: true });
    window.addEventListener("resize", on_scroll);
    update();
    update_depth();
  }
</script>
