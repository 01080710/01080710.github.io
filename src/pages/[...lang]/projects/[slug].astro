---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import SystemMap from "../../../components/SystemMap.astro";
import ProjectPeriod from "../../../components/ProjectPeriod.astro";
import { get_projects } from "../../../i18n/projects";
import { lang_from_param, lang_path, lang_static_paths, use_translations } from "../../../i18n/ui";

// One page per project per language: /projects/<slug>/ and /en/projects/<slug>/.
export async function getStaticPaths() {
  const paths = [];
  for (const { params } of lang_static_paths()) {
    for (const project of await get_projects(lang_from_param(params.lang))) {
      paths.push({ params: { lang: params.lang, slug: project.id }, props: { project } });
    }
  }
  return paths;
}

const { project } = Astro.props;
const lang        = lang_from_param(Astro.params.lang);
const t           = use_translations(lang);
const p           = project.data;
const { Content } = await render(project.body);
---

<Base title={p.title} description={p.summary} lang={lang}>
  <article class="case-study" data-accent={p.accent}>
    <a class="back mono" href={lang_path("projects/", lang)}>← All projects</a>

    <header class="page-head">
      <p class="eyebrow mono">{p.company}</p>
      <ProjectPeriod data={p} lang={lang} />
      <h1>{p.title}</h1>
      {p.subtitle && <p class="project-subtitle">{p.subtitle}</p>}
      {!p.tldr && <p class="lead">{p.summary}</p>}
    </header>

    <section class="case-zone zone-tech" aria-label={t("case.zone_tech")}>
      <p class="zone-label mono">Tech Choices</p>
      <dl class="case-meta">
        <div><dt class="mono">Role</dt><dd>{p.role}</dd></div>
        {p.focus && (
          <div><dt class="mono">Focus</dt><dd><ul class="tags tags-focus">{p.focus.map((f) => <li>{f}</li>)}</ul></dd></div>
        )}
        <div><dt class="mono">Stack</dt><dd><ul class="tags">{p.stack.map((s) => <li>{s}</li>)}</ul></dd></div>
      </dl>
    </section>

    {(p.system_map || p.tldr || p.metrics.length > 0) && (
      <section class="case-zone zone-brief" aria-label={t("case.zone_brief")}>
        <div class="zone-head">
          <p class="zone-label mono">Quick Read</p>
          {p.story && (
            <button type="button" class="story-start" hidden>
              <span aria-hidden="true">▶</span> {t("case.story_start")}<span class="story-start-count mono">{p.story.length}</span>
            </button>
          )}
        </div>
        {p.story && <script type="application/json" id="story-data" set:html={JSON.stringify(p.story)} />}
        {p.system_map && <SystemMap map={p.system_map.map} area={p.system_map.area} lang={lang} />}
        {p.tldr && (
          <dl class="tldr">
            <div class="tldr-problem"><dt class="mono">Problem</dt><dd>{p.tldr.problem}</dd></div>
            <div class="tldr-approach"><dt class="mono">Approach</dt><dd>{p.tldr.approach}</dd></div>
            <div class="tldr-result"><dt class="mono">Result</dt><dd>{p.tldr.result}</dd></div>
          </dl>
        )}
        {p.metrics.length > 0 && (
          <dl class="metrics metrics-lg">
            {p.metrics.map((m) => (
              <div><dt>{m.value}</dt><dd>{m.label}</dd></div>
            ))}
          </dl>
        )}
      </section>
    )}

    <section class="case-zone zone-detail" aria-label={t("case.zone_detail")}>
      <p class="zone-label mono">Deep Dive</p>
      <div class="prose">
        <Content />
      </div>
    </section>
  </article>
</Base>

<script>
  // Render ```mermaid code blocks. Loaded only on project pages; Astro bundles the npm package.
  import mermaid from "mermaid";

  // Labels for the script-built chapter / slide / CSV controls, picked by <html lang>.
  const en = document.documentElement.lang === "en";
  const L = en
    ? { overview: "Overview", prev_slide: "← Previous", next_slide: "Next →", slide: (n: number, t: string) => `Slide ${n}: ${t}`,
        prev_ch: "← Previous chapter", next_ch: "Next chapter →", csv_scroll: "scroll in any direction" }
    : { overview: "概覽", prev_slide: "← 上一張", next_slide: "下一張 →", slide: (n: number, t: string) => `第 ${n} 張：${t}`,
        prev_ch: "← 上一章", next_ch: "下一章 →", csv_scroll: "可上下左右捲動" };

  // Evidence images keep their full resolution; click opens the original so small text stays readable.
  document.querySelectorAll<HTMLImageElement>(".prose p > img, .prose td img").forEach((img) => {
    img.addEventListener("click", () => window.open(img.currentSrc || img.src, "_blank", "noopener"));
  });

  // ---------- Chapters: one "## section" per page, with collapsible tabs ----------
  // Progressive enhancement: without JS the page stays one long article.
  // Returns a way to open chapter ci, slide si (both 0-based) without scrolling, for the storyline guide.
  type Opener = (ci: number, si: number) => void;
  function buildChapters(): Opener | null {
    const prose = document.querySelector<HTMLElement>(".prose");
    if (!prose) return null;
    const heads = Array.from(prose.querySelectorAll<HTMLHeadingElement>(":scope > h2"));
    if (heads.length < 2) return null;

    const total    = heads.length;
    const pad      = (n: number) => String(n).padStart(2, "0");
    const chapters = heads.map((h2, i) => {
      const section = document.createElement("section");
      section.className = "chapter";
      section.id        = `ch-${i + 1}`;
      section.setAttribute("role", "tabpanel");
      section.setAttribute("aria-labelledby", `tab-${i + 1}`);
      h2.dataset.num = pad(i + 1);
      h2.before(section);

      // Move the heading and everything up to the next h2 into this chapter.
      let node: ChildNode | null = h2;
      while (node && (node === h2 || !(node instanceof HTMLHeadingElement && node.tagName === "H2"))) {
        const next: ChildNode | null = node.nextSibling;
        section.appendChild(node);
        node = next;
      }
      return { section, title: h2.textContent ?? "" };
    });

    // ---------- Slides inside a chapter ----------
    // `<hr data-slide="title">` in Markdown starts a new slide. Chapters without markers stay one page.
    // Without JS the markers are plain divider lines, so the article still reads top to bottom.
    type Deck = { count: number; current: () => number; show: (s: number, opts?: { scroll?: boolean }) => void };

    function buildSlides(section: HTMLElement, ci: number): Deck | null {
      const h2 = section.querySelector<HTMLElement>(":scope > h2");
      if (!h2 || !section.querySelector(":scope > hr[data-slide]")) return null;

      const slides: { el: HTMLElement; title: string }[] = [];
      const open_slide = (title: string) => {
        const el = document.createElement("div");
        // No id on purpose: a #ch-N-S hash must not make the browser jump past the chapter heading and slide bar.
        el.className = "slide";
        el.setAttribute("role", "group");
        el.setAttribute("aria-roledescription", "slide");
        slides.push({ el, title });
        return el;
      };

      let slide: HTMLElement | null = null;
      let node: ChildNode | null    = h2.nextSibling;
      while (node) {
        const next: ChildNode | null = node.nextSibling;
        if (node instanceof HTMLHRElement && node.dataset.slide !== undefined) {
          slide = open_slide(node.dataset.slide || `Part ${slides.length + 1}`);
          node.remove();
        } else if (!slide && node.nodeType === Node.TEXT_NODE && !node.textContent?.trim()) {
          node.remove();
        } else {
          // Content before the first marker becomes an "概覽" slide so nothing is dropped.
          (slide ??= open_slide(L.overview)).appendChild(node);
        }
        node = next;
      }

      // Slide title bar (clickable) above, pager (prev / dots / next) below.
      const bar = document.createElement("div");
      bar.className = "slide-tabs";
      const titles = slides.map((s, i) => {
        const b = document.createElement("button");
        b.type      = "button";
        b.className = "slide-tab";
        b.innerHTML = `<span class="slide-tab-num mono"></span><span></span>`;
        b.firstElementChild!.textContent = String(i + 1);
        b.lastElementChild!.textContent  = s.title;
        b.addEventListener("click", () => show(i));
        bar.appendChild(b);
        return b;
      });

      const pager = document.createElement("div");
      pager.className = "slide-pager";
      const prev = document.createElement("button");
      const next = document.createElement("button");
      prev.type = next.type = "button";
      prev.className = "slide-turn mono";
      next.className = "slide-turn mono";
      prev.textContent = L.prev_slide;
      next.textContent = L.next_slide;
      const dots = document.createElement("span");
      dots.className = "slide-dots";
      const dot_els = slides.map((s, i) => {
        const d = document.createElement("button");
        d.type      = "button";
        d.className = "slide-dot";
        d.setAttribute("aria-label", L.slide(i + 1, s.title));
        d.addEventListener("click", () => show(i));
        dots.appendChild(d);
        return d;
      });
      const folio = document.createElement("span");
      folio.className = "slide-folio mono";
      pager.append(prev, dots, folio, next);

      h2.after(bar, ...slides.map((s) => s.el), pager);

      let at = -1;
      function show(s: number, opts: { scroll?: boolean } = {}): void {
        if (s < 0 || s >= slides.length) return;
        const changed = at !== -1 && s !== at;
        slides.forEach((sl, i) => {
          sl.el.hidden = i !== s;
          sl.el.classList.remove("slide-in");
          titles[i].setAttribute("aria-current", String(i === s));
          dot_els[i].setAttribute("aria-current", String(i === s));
        });
        if (changed && !reduce) {
          void slides[s].el.offsetWidth; // restart animation
          slides[s].el.classList.add("slide-in");
        }
        prev.disabled     = s === 0;
        next.disabled     = s === slides.length - 1;
        folio.textContent = `${s + 1} / ${slides.length}`;
        // The chapter pager (next chapter) only appears once the reader reaches the last slide.
        section.querySelector<HTMLElement>(":scope > .chapter-pager")?.toggleAttribute("hidden", s !== slides.length - 1);
        at = s;
        if (changed) {
          sync_hash();
          if (opts.scroll !== false) scroll_to_chapter(ci, true);
        }
      }
      prev.addEventListener("click", () => show(at - 1));
      next.addEventListener("click", () => show(at + 1));

      return { count: slides.length, current: () => at, show };
    }

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const decks  = chapters.map((ch, ci) => buildSlides(ch.section, ci));

    // Tab bar
    const nav = document.createElement("nav");
    nav.className = "chapter-tabs";
    nav.setAttribute("aria-label", "Chapters");
    const list = document.createElement("div");
    list.className = "chapter-tab-list";
    list.setAttribute("role", "tablist");
    const progress = document.createElement("div");
    progress.className = "chapter-progress";
    nav.append(list, progress);

    const tabs = chapters.map((ch, i) => {
      const tab = document.createElement("button");
      tab.type      = "button";
      tab.id        = `tab-${i + 1}`;
      tab.className = "chapter-tab";
      tab.title     = ch.title;
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", ch.section.id);
      tab.innerHTML = `<span class="chapter-tab-num"></span><span class="chapter-tab-label"></span>`;
      tab.querySelector(".chapter-tab-num")!.textContent   = pad(i + 1);
      tab.querySelector(".chapter-tab-label")!.textContent = ch.title;
      // Reuse the heading's badge colour (defined once in global.css) as a dot on the tab.
      const tone = getComputedStyle(heads[i]).getPropertyValue("--tone").trim();
      if (tone) {
        tab.classList.add("has-tone");
        tab.style.setProperty("--tone", tone);
      }
      tab.addEventListener("click", () => go(i));
      list.appendChild(tab);
      return tab;
    });

    // Pager at the end of every chapter
    chapters.forEach((ch, i) => {
      const pager = document.createElement("div");
      pager.className = "chapter-pager";
      const make = (idx: number, dir: "prev" | "next") => {
        if (idx < 0 || idx >= total) return document.createElement("span");
        const b = document.createElement("button");
        b.type      = "button";
        b.className = `chapter-turn ${dir}`;
        b.innerHTML = `<span class="chapter-turn-dir mono"></span><span class="chapter-turn-title"></span>`;
        b.querySelector(".chapter-turn-dir")!.textContent   = dir === "prev" ? L.prev_ch : L.next_ch;
        b.querySelector(".chapter-turn-title")!.textContent = `${pad(idx + 1)} ${chapters[idx].title}`;
        b.addEventListener("click", () => go(idx));
        return b;
      };
      const folio = document.createElement("span");
      folio.className   = "chapter-folio mono";
      folio.textContent = `${pad(i + 1)} / ${pad(total)}`;
      pager.append(make(i - 1, "prev"), folio, make(i + 1, "next"));
      ch.section.appendChild(pager);
    });

    prose.classList.add("paged");
    prose.before(nav);

    let current = -1;

    // Hash = #ch-N, or #ch-N-S when the reader is past the first slide, so a slide can be shared.
    function sync_hash(): void {
      const deck  = decks[current];
      const slide = deck && deck.current() > 0 ? `-${deck.current() + 1}` : "";
      history.replaceState(null, "", `#ch-${current + 1}${slide}`);
    }

    // Jump to the chapter's heading, just below the sticky header (56px) + sticky tab bar.
    // The tab bar's own position cannot be the target: being sticky, it always reads "already here".
    // only_up: when turning slides, scroll back only if the heading is above the viewport (reader scrolled down).
    function scroll_to_chapter(i: number, only_up = false): void {
      const offset = 56 + nav.offsetHeight + 8;
      const top    = chapters[i].section.getBoundingClientRect().top + window.scrollY - offset;
      if (only_up && top >= window.scrollY) return;
      window.scrollTo({ top, behavior: reduce ? "auto" : "smooth" });
    }

    function go(i: number, opts: { scroll?: boolean; slide?: number | "last" } = {}): void {
      if (i === current || i < 0 || i >= total) return;
      const forward = i > current;
      chapters.forEach((ch, j) => {
        ch.section.hidden = j !== i;
        ch.section.classList.remove("turn-next", "turn-prev");
        tabs[j].setAttribute("aria-selected", String(j === i));
        tabs[j].tabIndex = j === i ? 0 : -1;
      });
      if (current !== -1 && !reduce) {
        void chapters[i].section.offsetWidth; // restart animation
        chapters[i].section.classList.add(forward ? "turn-next" : "turn-prev");
      }
      progress.style.setProperty("--progress", `${((i + 1) / total) * 100}%`);
      // Keep the active tab visible inside the (horizontally scrollable) tab list without moving the window.
      const listBox = list.getBoundingClientRect(), tabBox = tabs[i].getBoundingClientRect();
      list.scrollTo({ left: list.scrollLeft + tabBox.left - listBox.left - (listBox.width - tabBox.width) / 2 });
      const first_load = current === -1;
      current = i;
      const deck = decks[i];
      if (deck) deck.show(opts.slide === "last" ? deck.count - 1 : (opts.slide ?? 0), { scroll: false });
      // Keep a clean URL on first load; once the reader turns a page, the hash makes the chapter shareable.
      if (!first_load || location.hash) sync_hash();
      if (opts.scroll !== false && !first_load) scroll_to_chapter(i);
    }

    // Arrow keys turn slides first, then chapters; going back into a chapter lands on its last slide.
    document.addEventListener("keydown", (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      if (e.target instanceof Element && e.target.closest("input, textarea, select")) return;
      const deck = decks[current];
      if (e.key === "ArrowRight") {
        if (deck && deck.current() < deck.count - 1) deck.show(deck.current() + 1);
        else go(current + 1);
      }
      if (e.key === "ArrowLeft") {
        if (deck && deck.current() > 0) deck.show(deck.current() - 1);
        else go(current - 1, { slide: "last" });
      }
    });

    const from_hash = /^#ch-(\d+)(?:-(\d+))?$/.exec(location.hash);
    const start_ch  = from_hash ? Math.min(Math.max(Number(from_hash[1]) - 1, 0), total - 1) : 0;
    const start_sl  = from_hash?.[2] ? Number(from_hash[2]) - 1 : 0;
    go(start_ch, { scroll: false, slide: Math.min(Math.max(start_sl, 0), (decks[start_ch]?.count ?? 1) - 1) });
    // A slide link (#ch-N-S) has no matching element, so bring the chapter heading and slide bar into view ourselves.
    if (from_hash?.[2]) scroll_to_chapter(start_ch);

    return (ci, si) => {
      if (ci !== current) go(ci, { scroll: false, slide: si });
      else decks[ci]?.show(si, { scroll: false });
    };
  }

  const open_slide = buildChapters();

  // ---------- Storyline guide (frontmatter `story`, see docs/story.md) ----------
  // A docked bar walks the reader through the storyline steps in order. Nothing on the page moves: each step only
  // opens the right chapter / slide, scrolls its element into view and outlines it. A step can be split into beats
  // (`beats`: one CSS selector per click, inside the picked element) so the presenter reveals one idea at a time;
  // `dim` fades parts that belong to a later step. Leaving a step restores the element, so the static page is always
  // the final state. Without JS the button stays hidden. While open, → / Space continue, ← goes back, Esc closes.
  type Step = { label: string; line: string; at: string; pick?: string; beats?: string[]; dim?: string };
  const story_json = document.getElementById("story-data");
  const story_btn  = document.querySelector<HTMLButtonElement>(".story-start");
  if (story_json && story_btn) {
    const steps: Step[] = JSON.parse(story_json.textContent ?? "[]");
    const S = en
      ? { prev: "← Back", next: "Next", more: "Continue →", done: "Done", close: "Close the storyline", step: (n: number, t: string) => `Step ${n}: ${t}`, title: "Storyline" }
      : { prev: "← 上一步", next: "下一步", more: "繼續 →", done: "看完了", close: "關閉故事線", step: (n: number, t: string) => `第 ${n} 步：${t}`, title: "故事線" };
    const reduce_motion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const dock = document.createElement("aside");
    dock.className = "story-dock";
    dock.hidden    = true;
    dock.setAttribute("aria-label", S.title);
    dock.innerHTML = `
      <div class="story-dock-top">
        <ol class="story-dots"></ol>
        <p class="story-count mono" aria-live="polite"></p>
        <span class="story-beats" aria-hidden="true"></span>
        <button type="button" class="story-close" aria-label="${S.close}">✕</button>
      </div>
      <p class="story-line"></p>
      <div class="story-turns">
        <button type="button" class="story-prev mono"></button>
        <button type="button" class="story-next"></button>
      </div>`;
    // Inside the article so the dock picks up the project accent colour.
    (document.querySelector(".case-study") ?? document.body).appendChild(dock);
    const dots  = dock.querySelector<HTMLOListElement>(".story-dots")!;
    const count = dock.querySelector<HTMLElement>(".story-count")!;
    const pips  = dock.querySelector<HTMLElement>(".story-beats")!;
    const line  = dock.querySelector<HTMLElement>(".story-line")!;
    const prev  = dock.querySelector<HTMLButtonElement>(".story-prev")!;
    const next  = dock.querySelector<HTMLButtonElement>(".story-next")!;
    prev.textContent = S.prev;
    const dot_btns = steps.map((s, i) => {
      const li = document.createElement("li");
      const b  = document.createElement("button");
      b.type = "button";
      b.className = "story-dot";
      b.setAttribute("aria-label", S.step(i + 1, s.label));
      b.title = s.label;
      b.addEventListener("click", () => show(i));
      li.appendChild(b);
      dots.appendChild(li);
      return b;
    });

    let at = -1;      // current step
    let beat = 0;     // current beat inside the step (0-based)
    let focused: Element | null = null;
    let touched: Element[] = [];
    let playing: HTMLVideoElement[] = [];
    const beat_count = (i: number) => Math.max(steps[i]?.beats?.length ?? 0, 1);

    function target_of(step: Step): Element | null {
      if (step.at === "map") return document.querySelector(".zone-brief .system-map");
      const m = /^ch-(\d+)-(\d+)$/.exec(step.at);
      if (!m) return null;
      const [ci, si] = [Number(m[1]) - 1, Number(m[2]) - 1];
      open_slide?.(ci, si);
      const slide = document.querySelectorAll<HTMLElement>(`#ch-${ci + 1} .slide`)[si];
      if (!slide) return document.getElementById(`ch-${ci + 1}`);
      return (step.pick && slide.querySelector(step.pick)) || slide;
    }

    function clear_beats(): void {
      touched.forEach((el) => el.classList.remove("beat-pending", "beat-shown", "beat-now", "beat-dim"));
      touched = [];
      playing.forEach((v) => v.pause());
      playing = [];
    }
    // Groups before the current beat are shown, the current one is shown and marked, later ones wait faded.
    function apply_beats(): void {
      clear_beats();
      const step = steps[at];
      if (!focused || !step) return;
      const mark = (el: Element, cls: string[]) => { el.classList.add(...cls); touched.push(el); };
      if (step.dim) focused.querySelectorAll(step.dim).forEach((el) => mark(el, ["beat-dim"]));
      (step.beats ?? []).forEach((sel, k) => {
        const cls = k < beat ? ["beat-shown"] : k === beat ? ["beat-shown", "beat-now"] : ["beat-pending"];
        focused!.querySelectorAll(sel).forEach((el) => mark(el, cls));
      });
      // A beat inside a horizontal screenshot strip slides the strip to it, without moving the page.
      focused.querySelectorAll<HTMLElement>(".shot-strip > .beat-now").forEach((el) => {
        el.parentElement!.scrollTo({ left: el.offsetLeft, behavior: reduce_motion ? "auto" : "smooth" });
      });
      // A recording in the current beat plays muted from the start; leaving the beat pauses it.
      focused.querySelectorAll<HTMLVideoElement>(".beat-now video, video.beat-now").forEach((v) => {
        v.muted = true;
        v.currentTime = 0;
        void v.play().catch(() => {});
        playing.push(v);
      });
    }

    function update_dock(): void {
      const step = steps[at];
      const n    = beat_count(at);
      dot_btns.forEach((b, j) => b.setAttribute("aria-current", String(j === at)));
      count.textContent = `${at + 1} / ${steps.length}${en ? "  " : "　"}${step.label}`;
      pips.innerHTML    = n > 1 ? Array.from({ length: n }, (_, k) => `<i class="${k <= beat ? "on" : ""}"></i>`).join("") : "";
      line.textContent  = step.line;
      prev.disabled     = at === 0 && beat === 0;
      next.textContent  = beat < n - 1 ? S.more
        : at === steps.length - 1 ? S.done
        : `${S.next}${en ? ": " : "："}${steps[at + 1].label} →`;
    }

    // Place the element in the space between the sticky bars (top) and the dock (bottom): centred when it fits,
    // otherwise top-aligned so its beginning is readable. Waits a frame so the newly shown slide has laid out.
    function place(): void {
      if (!focused) return;
      const bar_h  = 56 + (document.querySelector<HTMLElement>(".chapter-tabs")?.offsetHeight ?? 0) + 16;
      const room   = window.innerHeight - dock.offsetHeight - 32 - bar_h;
      const box    = focused.getBoundingClientRect();
      const offset = box.height < room ? (room - box.height) / 2 : 0;
      window.scrollTo({ top: window.scrollY + box.top - bar_h - offset, behavior: reduce_motion ? "auto" : "smooth" });
    }

    function show(i: number, start: number | "last" = 0): void {
      if (i < 0 || i >= steps.length) return;
      clear_beats();
      at   = i;
      beat = start === "last" ? beat_count(i) - 1 : start;
      focused?.classList.remove("story-focus");
      focused = target_of(steps[i]);
      focused?.classList.add("story-focus");
      apply_beats();
      update_dock();
      requestAnimationFrame(place);
      // A lazy image has no height until it loads, and one above the element pushes it down when it does;
      // place again once every image in the same slide has its real size.
      const area = focused?.closest(".slide") ?? focused;
      const imgs = area ? [area, ...area.querySelectorAll("img")].filter((el): el is HTMLImageElement => el instanceof HTMLImageElement && !el.complete) : [];
      const step_now = at;
      imgs.forEach((img) => img.addEventListener("load", () => { if (at === step_now) place(); }, { once: true }));
    }

    function forward(): void {
      if (beat < beat_count(at) - 1) { beat += 1; apply_beats(); update_dock(); }
      else if (at < steps.length - 1) show(at + 1);
      else close();
    }
    function back(): void {
      if (beat > 0) { beat -= 1; apply_beats(); update_dock(); }
      else if (at > 0) show(at - 1, "last");
    }

    function open(): void {
      dock.hidden = false;
      document.body.classList.add("story-open");
      show(0);
      next.focus();
    }
    function close(): void {
      dock.hidden = true;
      document.body.classList.remove("story-open");
      clear_beats();
      focused?.classList.remove("story-focus");
      focused = null;
      story_btn!.focus();
    }

    story_btn.hidden = false;
    story_btn.addEventListener("click", open);
    prev.addEventListener("click", back);
    next.addEventListener("click", forward);
    dock.querySelector(".story-close")!.addEventListener("click", close);
    // Mermaid re-renders on a theme switch and replaces its SVG; re-apply the current beat to the new nodes.
    window.addEventListener("themechange", () => { if (!dock.hidden) setTimeout(apply_beats, 300); });
    // Capture phase on window runs before the chapter handler on document, so the guide owns these keys while open.
    window.addEventListener("keydown", (e) => {
      if (dock.hidden || e.altKey || e.ctrlKey || e.metaKey) return;
      if (e.target instanceof Element && e.target.closest("input, textarea, select")) return;
      const on_button = e.target instanceof Element && e.target.closest("button");
      if (e.key === "ArrowRight" || (e.key === " " && !on_button)) { e.preventDefault(); e.stopPropagation(); forward(); }
      if (e.key === "ArrowLeft")  { e.preventDefault(); e.stopPropagation(); back(); }
      if (e.key === "Escape")     { e.stopPropagation(); close(); }
    }, true);
  }

  // ---------- CSV viewer: <div class="csv-viewer" data-src="..."> in Markdown ----------
  // Without JS the download link inside the div is still there.
  function parseCsv(text: string): string[][] {
    const rows: string[][] = [];
    let row: string[] = [], field = "", quoted = false;
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (quoted) {
        if (c === '"' && text[i + 1] === '"') { field += '"'; i++; }
        else if (c === '"') quoted = false;
        else field += c;
      } else if (c === '"') quoted = true;
      else if (c === ",") { row.push(field); field = ""; }
      else if (c === "\n") { row.push(field.replace(/\r$/, "")); rows.push(row); row = []; field = ""; }
      else field += c;
    }
    if (field || row.length) { row.push(field); rows.push(row); }
    return rows;
  }

  const escapeHtml = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  // Same definition as the page text: review = error*, or a note naming a wrong / duplicate refund.
  const ERROR_NOTE = /wrong|double|twice|duplicate|overpaid|underpaid|correct amount/i;

  // Collapsed by default: the CSV is fetched and rendered only the first time its <details> is opened.
  for (const viewer of document.querySelectorAll<HTMLElement>(".csv-viewer[data-src]")) {
    const details = viewer.closest("details");
    if (!details) { void loadCsv(viewer); continue; }
    details.addEventListener("toggle", () => { if (details.open) void loadCsv(viewer); });
  }

  async function loadCsv(viewer: HTMLElement): Promise<void> {
    if (viewer.dataset.loaded) return;
    viewer.dataset.loaded = "1";
    const src = new URL(viewer.dataset.src!, location.href).href;
    try {
      const res = await fetch(src);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const [header, ...rows] = parseCsv(await res.text()).filter((r) => r.length > 1);
      const col  = (name: string) => header.indexOf(name);
      const [iTx, iNote, iReview] = [col("Tx"), col("Note"), col("Review")];
      const body = rows.map((r) => {
        const cls = r[iTx] === "-" ? "is-empty"
          : /^error/i.test(r[iReview] ?? "") || ERROR_NOTE.test(`${r[iNote] ?? ""} ${r[iReview] ?? ""}`) ? "is-error" : "";
        return `<tr class="${cls}">${r.map((v) => `<td>${escapeHtml(v)}</td>`).join("")}</tr>`;
      }).join("");
      const wrap = document.createElement("div");
      wrap.className = "csv-table-wrap";
      wrap.innerHTML = `<table class="csv-table"><thead><tr>${header.map((h) => `<th>${escapeHtml(h)}</th>`).join("")}</tr></thead><tbody>${body}</tbody></table>`;
      const meta = document.createElement("p");
      meta.className   = "csv-meta mono";
      meta.textContent = `${rows.length.toLocaleString()} rows · ${L.csv_scroll}`;
      viewer.prepend(meta, wrap);
    } catch (err) {
      console.error("CSV viewer failed", { src, err });
    }
  }

  // ---------- Mermaid ----------
  // Astro emits excluded languages as <pre><code class="language-mermaid">…</code></pre>.
  // mermaid.render() measures text in its own temporary element, so diagrams inside hidden chapters still size correctly.
  const blocks = Array.from(document.querySelectorAll<HTMLElement>("pre > code.language-mermaid"));
  if (blocks.length > 0) {
    // Keep each diagram's source so it can be re-rendered when the header theme toggle fires "themechange".
    const diagrams = blocks.map((code) => {
      const div     = document.createElement("div");
      div.className = "mermaid";
      code.parentElement!.replaceWith(div);
      return { div, source: code.textContent ?? "" };
    });

    let render_count = 0;
    const render_diagrams = async () => {
      const dark = document.documentElement.dataset.theme === "dark";
      render_count += 1;
      mermaid.initialize({ startOnLoad: false, theme: dark ? "dark" : "neutral", securityLevel: "strict" });
      for (const [i, d] of diagrams.entries()) {
        try {
          // Fresh id per render so a re-render never collides with the SVG already in the page
          const { svg } = await mermaid.render(`mermaid-${render_count}-${i}`, d.source);
          d.div.innerHTML = svg;
        } catch (err) {
          console.error("Mermaid render failed", { index: i, err });
          d.div.textContent = d.source;
        }
      }
    };

    await render_diagrams();
    window.addEventListener("themechange", render_diagrams);
  }
</script>
