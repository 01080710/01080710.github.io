---
import Base from "../../layouts/Base.astro";
import BrandMark from "../../components/BrandMark.astro";
import CopyEmail from "../../components/CopyEmail.astro";
import ImpactMap from "../../components/ImpactMap.astro";
import PipelineView from "../../components/PipelineView.astro";
import ProfilePhoto from "../../components/ProfilePhoto.astro";
import { get_profile } from "../../i18n/profile";
import { get_keywords, get_production_lines } from "../../i18n/projects";
import { lang_from_param, lang_path, lang_static_paths, use_translations } from "../../i18n/ui";

export const getStaticPaths = lang_static_paths;

const lang    = lang_from_param(Astro.params.lang);
const profile = get_profile(lang);
const t       = use_translations(lang);

// Home = a 30-second pitch: value statement + first intro paragraph -> keyword strip -> impact map
// (company map + one card per project) -> contact card. Project cards and numbers come from the project files (see ImpactMap.astro).
const { email } = profile.contact;
const keywords  = await get_keywords(lang);

// Hero production lines: one per company (map), one machine per project (see get_production_lines).
const hero_lines = await get_production_lines(lang);
const hero_text = { result: t("home.pipe_result"), open: t("home.machine_open"), building: t("home.building") };
---

<Base lang={lang}>
  <section class="hero hero-split" style={`--hp-lines:${hero_lines.length}`}>
    <!-- Project machines on one production line per company (JS only): drawn by the script below from the real
         layout on wide screens, as a still illustration under the text on narrow ones. Without JS the hero is unchanged;
         the impact cards further down carry the same projects and links for keyboard and screen-reader users. -->
    <div class="hero-scene">
      <svg class="hero-pipes" aria-hidden="true" hidden
           data-lines={JSON.stringify(hero_lines)} data-text={JSON.stringify(hero_text)}></svg>
    </div>
    <button type="button" class="hero-drop" hidden>{t("home.pipe_drop")}</button>
    <div class="hero-machine-card" aria-hidden="true" hidden>
      <p class="hmc-title"></p>
      <p class="hmc-core"><span class="mono">{t("home.core")}</span> <span class="hmc-core-text"></span></p>
      <dl class="hmc-ba">
        <div><dt>{t("home.before")}</dt><dd class="hmc-before"></dd></div>
        <div><dt>{t("home.after")}</dt><dd class="hmc-after"></dd></div>
      </dl>
      <p class="hmc-go mono"></p>
    </div>
    <div class="hero-text">
      <script is:inline>
        // Before first paint: the entrance (pipes snap together, headline and title assemble from scattered
        // characters) plays once per session; .ts-pending hides that text until the script takes over (CSS has a
        // timed fallback). .has-pipes reserves the pipeline band now, so the hero does not jump when it is drawn.
        try {
          const root = document.documentElement;
          if (sessionStorage.getItem("hero-run")) root.classList.add("hero-seen");
          else {
            sessionStorage.setItem("hero-run", "1");
            if (!matchMedia("(prefers-reduced-motion: reduce)").matches) root.classList.add("ts-pending");
          }
        } catch { /* storage blocked: the pipeline plays every time, the text stays still */ }
        if (matchMedia("(min-width: 900px)").matches) document.currentScript.closest(".hero").classList.add("has-pipes");
      </script>
      <p class="eyebrow mono">{profile.name_zh} · {profile.name}</p>
      <h1 class="hero-statement">{profile.tagline}</h1>
      <p class="hero-intro">{profile.intro[0]}</p>
      <p class="hero-role">
        <span class="mono">{profile.title}</span>
        <a class="open-to-work" href={lang_path("contact/", lang)}>{t("home.open_to_work")} →</a>
      </p>
      <div class="hero-actions">
        <a class="btn primary" href={lang_path("projects/", lang)}>{t("home.view_projects")}</a>
        <a class="btn" href={lang_path("contact/", lang)}>{t("home.contact")}</a>
        <!-- Opens the pipeline view (PipelineView.astro); revealed by its script, so it never shows without JS. -->
        <button type="button" class="btn pv-open" aria-haspopup="dialog" hidden>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M5 10 C10 10 10 4.5 14 4.5 M5 10 C10 10 10 15.5 14 15.5" />
            <circle cx="4" cy="10" r="2.6" /><circle cx="16" cy="4.5" r="2.6" /><circle cx="16" cy="15.5" r="2.6" />
          </svg>
          {t("home.pipeline_view")}
        </button>
      </div>
      <p class="intro-links">
        <a href={lang_path("about/", lang)}>{t("home.about_link")}</a>
        <a href={`${lang_path("about/", lang)}#off-the-clock`}>{t("home.life_link")}</a>
      </p>
    </div>
    <ProfilePhoto lang={lang} />
  </section>

  <!-- Keywords recruiters scan for; computed from the projects (see get_keywords). -->
  <section class="keyword-strip" aria-label={t("home.keywords")}>
    <dl>
      <div><dt class="mono">{t("home.skills")}</dt><dd><ul class="focus-groups">{keywords.groups.map((g) => (
        <li>
          <p class="focus-name">{g.label}</p>
          <p class="focus-terms">{g.terms.map((k, i) => <><span>{k}{i < g.terms.length - 1 && " ·"}</span>{" "}</>)}</p>
        </li>
      ))}</ul></dd></div>
      <div><dt class="mono">{t("home.tools")}</dt><dd><ul>{keywords.tools.map((k) => <li class="mono">{k}</li>)}</ul></dd></div>
    </dl>
  </section>

  <ImpactMap lang={lang} />

  <section class="section">
    <div class="home-contact">
      <BrandMark class="home-contact-mark" />
      <div class="home-contact-text">
        <h2>{t("contact.title")}</h2>
        <p class="muted">{profile.contact_invite}</p>
      </div>
      <div class="home-contact-actions">
        {email && <a class="home-contact-email" href={`mailto:${email}`}>{email}</a>}
        {email && <CopyEmail email={email} lang={lang} />}
        <a class="home-contact-more mono" href={lang_path("contact/", lang)}>{t("home.contact_link")}</a>
      </div>
    </div>
  </section>

  <PipelineView lang={lang} />
</Base>

<script>
  // Hero: the projects as machines on production lines, one line per company (data from the project files and
  // src/data/machines.ts). Raw packets leave each company's source, run the trunk, turn into one project's machine on
  // a branch that runs back in depth, and that machine does the project's own job on them (match two reports, line two
  // lanes up by a key, validate and query, or pass consecutive stages). Good records leave sealed in the project's
  // colour and rise into the photo; flagged ones drop into the machine's outlet tray. An in-progress project is drawn as
  // scaffolding and gets no packets.
  // Drawn as a blueprint: axonometric line work on grid paper, glass housings (src/lib/blueprint.ts). Interaction:
  // hovering a machine opens it (the housing lifts, the mechanism is labelled) and shows the project's before / after;
  // clicking flies the camera into it and opens the case study, whose header shows the same machine exploded into its
  // layers. Dropping a packet (button, or a click on an empty spot) makes the camera follow it to the end. Moving the
  // pointer turns the drawing a little. First visit of a session: pieces snap together, then packets flood in.
  // Narrow screens (< 900px): a still illustration of the same scene under the text. Reduced motion: a still frame,
  // no camera moves, clicks open the case study at once. Paused while off screen.
  import { svg_el as el, make_packet, place, set_clean, rand } from "../../lib/pipe-packets";
  import { assemble } from "../../lib/scatter-text";
  import { assemble_photo, type PhotoAssembly } from "../../lib/photo-assemble";
  import { BASE_VIEW, recede, ring, set_layer_tilt, tilt, type View } from "../../lib/blueprint";

  type Kind = "match" | "align" | "query" | "stages" | "scaffold";
  interface MachineData {
    area: string; kind: Kind; accent: string; name: string; note: string; parts: string[]; outlet: string;
    href: string; building: boolean; title: string; before: string; after: string;
  }
  interface LineData { company: string; machines: MachineData[] }

  const svg    = document.querySelector<SVGSVGElement>(".hero-pipes");
  const hero   = svg?.closest<HTMLElement>(".hero") ?? null;
  const drop   = hero?.querySelector<HTMLButtonElement>(".hero-drop") ?? null;
  const card   = hero?.querySelector<HTMLElement>(".hero-machine-card") ?? null;
  const blob   = hero?.querySelector<HTMLElement>(".hero-blob") ?? null;
  const wide   = matchMedia("(min-width: 900px)");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const LINES: LineData[] = JSON.parse(svg?.dataset.lines ?? "[]");
  const TEXT: Record<string, string> = JSON.parse(svg?.dataset.text ?? "{}");

  const SPAWN_S = 0.62, V = 118, GAP = 15, PROC_S = 1.1, MAX_Q = 3, FLAG_P = 0.22, FAIL_P = 0.15, MAX_TRAY = 4;
  const MW = 68, MH = 44, DM = 34, DB = 60;      // machine width, height, depth; how far it sits behind the trunk
  const LINE_GAP = 104;                          // second company's line, below the first
  const ASSEMBLED_S = 1.7;                       // keep in step with the snap timings below and --hp-arrive
  const EXPRESS = 3;                             // speed-up of the opening batch (photo-assemble)
  const PHOTO_DEADLINE_S = 9;                    // first visit: show the whole photo by now even if a line is slow

  // ---------- projection ----------
  // Pipes run in one front plane, sheared so trunks run down to the right at SLOPE. A point is (x, y, depth) in that
  // plane; depth recedes up and to the right along R, which the pointer tilt turns. Lengths are measured in 3D, so
  // turning the view never moves a packet along its route.
  type P3 = [number, number, number];
  const SLOPE = (5 * Math.PI) / 180, COS = Math.cos(SLOPE), SIN = Math.sin(SLOPE);
  let shift = { x: 0, y: 0 };
  let R = { x: 0, y: 0 };
  let view: View = BASE_VIEW;
  let redraw: (() => void)[] = [];
  const f = (v: number) => v.toFixed(1);
  const to_screen = (x: number, y: number) => ({ x: COS * x + shift.x, y: SIN * x + y + shift.y });
  const to_plane = (x: number, y: number) => { const px = (x - shift.x) / COS; return { x: px, y: y - SIN * px - shift.y }; };
  const proj = (p: P3) => ({ x: p[0] + R.x * p[2], y: p[1] + R.y * p[2] });
  const at = (x: number, y: number, d: number) => `${f(x + R.x * d)},${f(y + R.y * d)}`;
  const screen_of = (p: P3) => { const q = proj(p); return to_screen(q.x, q.y); };
  function set_view(v: View) {
    view = v;
    const r = recede(v);
    R = { x: r.x / COS, y: r.y - (SIN * r.x) / COS };
    for (const fn of redraw) fn();
  }
  const live_draw = (fn: () => void) => { fn(); redraw.push(fn); };

  class Route3 {
    readonly length: number;
    private readonly cum: number[] = [0];
    constructor(private readonly pts: P3[]) {
      for (let i = 1; i < pts.length; i++) {
        const a = pts[i - 1], b = pts[i];
        this.cum.push(this.cum[i - 1] + Math.hypot(b[0] - a[0], b[1] - a[1], b[2] - a[2]));
      }
      this.length = this.cum[this.cum.length - 1];
    }
    point(s: number): P3 {
      s = Math.min(Math.max(s, 0), this.length);
      let i = 1;
      while (i < this.cum.length - 1 && this.cum[i] < s) i++;
      const a = this.pts[i - 1], b = this.pts[i], span = this.cum[i] - this.cum[i - 1], u = span ? (s - this.cum[i - 1]) / span : 0;
      return [a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u, a[2] + (b[2] - a[2]) * u];
    }
    at(s: number) { return proj(this.point(s)); }
  }
  // A rounded corner from a through c to b (quadratic), as points.
  const bend = (a: P3, c: P3, b: P3, n = 6): P3[] => Array.from({ length: n }, (_, k) => {
    const t = (k + 1) / n, u = 1 - t;
    return [u * u * a[0] + 2 * u * t * c[0] + t * t * b[0], u * u * a[1] + 2 * u * t * c[1] + t * t * b[1], u * u * a[2] + 2 * u * t * c[2] + t * t * b[2]] as P3;
  });

  // ---------- drawing ----------
  type Layer = "grid" | "back" | "edge" | "core" | "center" | "house" | "packets" | "glass" | "top" | "labels" | "rise";
  let layers: Record<Layer, Element>;
  let snap_of = (_k: number) => "";
  const piece = (layer: Layer, k: number, extra: Record<string, string> = {}) =>
    el("g", { class: "hp-piece", style: snap_of(k), ...extra }, layers[layer]);
  function tube(pts: P3[], k: number, parent?: { edge: Element; core: Element; center: Element }) {
    const host = parent ?? { edge: layers.edge, core: layers.core, center: layers.center };
    const parts = (["edge", "core", "center"] as const).map((c) => el("path", { class: `hp-${c} hp-piece`, style: snap_of(k) }, host[c]));
    live_draw(() => {
      const d = "M" + pts.map((p) => { const q = proj(p); return `${f(q.x)} ${f(q.y)}`; }).join(" L");
      for (const p of parts) p.setAttribute("d", d);
    });
  }
  // A collar around a pipe at p: a circle across the pipe (along x: in the depth/vertical plane), seen as an ellipse.
  function flange(p: P3, along_x: boolean, k: number, parent: Element) {
    const c = el("polygon", { class: "hp-flange", style: `--d:${0.6 + k * 0.12}s` }, parent);
    live_draw(() => { const q = proj(p); c.setAttribute("points", along_x ? ring(q.x, q.y, 12.5, R, { x: 0, y: 1 }) : ring(q.x, q.y, 12.5, { x: 1, y: 0 }, R)); });
  }
  // A closed glass housing: x0..x1 by y0..y1 in the plane, centred at depth dc, d deep. Hidden edges go to `back`.
  function housing(x0: number, y0: number, x1: number, y1: number, dc: number, d: number, back: Element, glass: Element) {
    const hidden = el("path", { class: "hp-hidden" }, back);
    const [front, roof, side] = ["hp-front", "hp-roof", "hp-side"].map((c) => el("polygon", { class: `hp-glass ${c}` }, glass));
    const fz = dc - d / 2, bz = dc + d / 2;
    live_draw(() => {
      hidden.setAttribute("d", `M${at(x0, y1, bz)} L${at(x1, y1, bz)} M${at(x0, y0, bz)} L${at(x0, y1, bz)} M${at(x0, y1, fz)} L${at(x0, y1, bz)}`);
      front.setAttribute("points", [at(x0, y0, fz), at(x1, y0, fz), at(x1, y1, fz), at(x0, y1, fz)].join(" "));
      roof.setAttribute("points", [at(x0, y0, fz), at(x1, y0, fz), at(x1, y0, bz), at(x0, y0, bz)].join(" "));
      side.setAttribute("points", [at(x1, y0, fz), at(x1, y0, bz), at(x1, y1, bz), at(x1, y1, fz)].join(" "));
    });
  }
  // An open tray (no roof) at depth dc.
  function tray(x0: number, y0: number, x1: number, y1: number, dc: number, d: number, back: Element, glass: Element) {
    const hidden = el("path", { class: "hp-hidden" }, back);
    const inner = el("path", { class: "hp-tray" }, back);
    const front = el("polygon", { class: "hp-glass hp-front" }, glass);
    const side = el("polygon", { class: "hp-glass hp-side" }, glass);
    const rim = el("path", { class: "hp-tray" }, glass);
    const fz = dc - d / 2, bz = dc + d / 2;
    live_draw(() => {
      hidden.setAttribute("d", `M${at(x0, y1, fz)} L${at(x0, y1, bz)} L${at(x1, y1, bz)}`);
      inner.setAttribute("d", `M${at(x0, y1, bz)} L${at(x0, y0, bz)} L${at(x1, y0, bz)}`);
      front.setAttribute("points", [at(x0, y0, fz), at(x1, y0, fz), at(x1, y1, fz), at(x0, y1, fz)].join(" "));
      side.setAttribute("points", [at(x1, y0, fz), at(x1, y0, bz), at(x1, y1, bz), at(x1, y1, fz)].join(" "));
      rim.setAttribute("d", `M${at(x0, y0, fz)} L${at(x0, y0, bz)}`);
    });
  }
  function floor_grid(x0: number, x1: number, y: number, near: number, far: number, step = 24) {
    const path = el("path", { class: "hp-grid" }, layers.grid);
    live_draw(() => {
      let d = "";
      for (let t = near; t <= far + 0.1; t += step) d += `M${at(x0, y, t)} L${at(x1, y, t)}`;
      for (let x = x0; x <= x1 + 0.1; x += step) d += `M${at(x, y, near)} L${at(x, y, far)}`;
      path.setAttribute("d", d);
    });
  }
  // Upright text in screen space, anchored to a 3D point.
  function text_at(p: P3, dy: number, cls: string, value: string, parent: Element) {
    const t = el("text", { class: cls }, parent);
    t.textContent = value;
    live_draw(() => { const s = screen_of(p); t.setAttribute("x", f(s.x)); t.setAttribute("y", f(s.y + dy)); });
    return t;
  }
  // Generic database icon for a company source, drawn on the source's front face.
  function source_icon(c: number, y: number, g: Element) {
    el("path", { d: `M${c - 9} ${y - 6} V${y + 6} A9 3.2 0 0 0 ${c + 9} ${y + 6} V${y - 6}`, class: "hp-icon" }, g);
    el("path", { d: `M${c - 9} ${y} A9 3.2 0 0 0 ${c + 9} ${y}`, class: "hp-icon" }, g);
    el("ellipse", { cx: c, cy: y - 6, rx: 9, ry: 3.2, class: "hp-icon hp-icon-top" }, g);
  }

  // ---------- scene ----------
  interface Machine {
    d: MachineData; line: number; x: number; y: number; yc: number;
    in_route: Route3; out_route: Route3; tray_route: Route3 | null; tray_floor: number;
    queue: Packet[]; cur: Packet | null; busy: number; resting: Packet[];
    groups: Element[]; glass: Element; mech: Element; flag: Element | null; twin: Element | null; bar: Element | null;
    ports: Element[]; cells: Element[]; gate: Element | null;
  }
  interface Packet {
    g: SVGGElement; m: Machine; leg: "fly" | "in" | "proc" | "out" | "tray" | "rest"; s: number; v: number;
    a: number; spin: number; mine: boolean; t: number; outcome: "ok" | "flag" | "fail"; off: { x: number; y: number };
    fx: number; fy: number; qx: number; qy: number; port: number; express?: boolean;
  }
  interface Scene { machines: Machine[]; lines: { inlet: P3; machines: Machine[]; next: number; spawn_t: number }[]; loose: Packet[] }
  let scene: Scene | null = null;
  let build_id = 0;
  let inline = false;
  // First visit: the photo is drawn in as live projects deliver (see photo-assemble.ts); any rebuild shows it whole.
  let photo: PhotoAssembly = { arrive() {}, finish() {} };

  function build(animate: boolean) {
    if (!svg || !hero || !drop) return;
    if (!animate) photo.finish();
    stop();
    scene = null;
    follow = null;
    const id = ++build_id;
    inline = !wide.matches;
    hero.classList.toggle("has-pipes", !inline);
    svg.classList.toggle("is-inline", inline);
    svg.hidden = false;
    drop.hidden = true;
    if (card) card.hidden = true;
    svg.replaceChildren();
    redraw = [];
    cam = { x: 0, y: 0, s: 1 }; cam_goal = { x: 0, y: 0, s: 1 };

    // Layout. Wide: from the live hero (trunk under the text, rising into the photo). Narrow: a fixed 900-wide
    // drawing scaled to the column, ending in a "result" tower.
    let W: number, H: number, Y: number, cx: number, px: number, top: number;
    if (inline) {
      W = 900; H = 330; Y = 118; cx = 150; px = 800; top = 0;
      shift = { x: cx * (1 - COS), y: -SIN * cx };
    } else {
      const text = hero.querySelector<HTMLElement>(".hero-text")!, img = hero.querySelector<HTMLElement>(".hero-photo img")!;
      const box = hero.getBoundingClientRect(), tb = text.getBoundingClientRect(), pb = img.getBoundingClientRect();
      W = box.width; H = box.height;
      Y = tb.bottom - box.top + 96;
      cx = Math.max(150, W * 0.15);
      shift = { x: cx * (1 - COS), y: -SIN * cx };           // pivot on the first merge, so the sources stay put
      const photo = to_plane(pb.left + pb.width / 2 - box.left, pb.bottom - box.top + 14);
      px = photo.x; top = photo.y;
    }
    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
    svg.classList.toggle("is-static", !animate);
    hero.classList.toggle("hp-animate", animate);
    set_view(view);
    snap_of = (k: number) => animate ? `--d:${(0.2 + k * 0.12).toFixed(2)}s;--dx:0px;--dy:${k < 2 ? 0 : -24}px` : "";

    const clip_id = "hp-band";
    const defs = el("defs", {}, svg);
    const clip = el("clipPath", { id: clip_id }, defs);
    const band_top = inline ? 0 : Y - 88;                    // just under the hero text: the camera never covers it
    band = { top: band_top, bottom: H, width: W };
    el("rect", { x: -12, y: band_top, width: W + 24, height: inline ? H + 40 : H - band_top }, clip);
    // plus the column of the rise into the photo, so packets reach it (closed while the camera is zoomed in)
    rise_clip = null;
    if (!inline) { const r = to_screen(px, top); rise_clip = el("rect", { x: r.x - 24, y: r.y - 30, width: 48, height: band_top - r.y + 32 }, clip); }
    const clipped = el("g", { "clip-path": `url(#${clip_id})` }, svg);
    cam_g = el("g", {}, clipped);
    const matrix = `matrix(${COS} ${SIN} 0 1 ${shift.x} ${shift.y})`;
    const plane = el("g", { transform: matrix }, cam_g);
    const ids: Layer[] = ["grid", "back", "edge", "core", "center", "house", "packets", "glass", "top"];
    layers = Object.fromEntries(ids.map((k) => [k, el("g", {}, plane)])) as Record<Layer, Element>;
    layers.labels = el("g", {}, cam_g);
    layers.rise = el("g", { transform: matrix, class: "hp-rise" }, svg);
    const rise_tube = { edge: el("g", {}, layers.rise), core: el("g", {}, layers.rise), center: el("g", {}, layers.rise) };

    const sx = 54;
    const ys = LINES.map((_, i) => Y + i * LINE_GAP);
    const x_end = inline ? px : px - 16;                       // where line 1 turns up (photo) or ends (tower)
    const jx = x_end - 64;                                     // where line 2 rises into line 1
    floor_grid(0, x_end - 40, ys[ys.length - 1] + 38, -30, 96);

    // Tails: line 1 runs on to the photo (or the tower); every later line rises into line 1 at jx.
    const tail0: P3[] = inline ? [[x_end, Y, 0]]
      : [[x_end, Y, 0], ...bend([x_end, Y, 0], [px, Y, 0], [px, Y - 16, 0]), [px, top, 0]];
    const join_of = (li: number): P3[] => {
      const y = ys[li];
      return [[jx - 16, y, 0], ...bend([jx - 16, y, 0], [jx, y, 0], [jx, y - 16, 0]), [jx, Y + 16, 0], ...bend([jx, Y + 16, 0], [jx, Y, 0], [jx + 16, Y, 0])];
    };
    const tail_of = (li: number, from_x: number): P3[] => li === 0
      ? [[from_x, Y, 0], ...tail0]
      : [[from_x, ys[li], 0], ...join_of(li), ...tail0];

    // k 0: company sources; k 1: trunks
    const machines: Machine[] = [];
    const lines: Scene["lines"] = [];
    LINES.forEach((line, li) => {
      const y = ys[li];
      const glass = piece("glass", 0);
      housing(0, y - 15, sx, y + 15, 0, 28, piece("back", 0), glass);
      const face = el("g", {}, glass);
      live_draw(() => face.setAttribute("transform", `translate(${f(-R.x * 14)} ${f(-R.y * 14)})`));
      source_icon(sx / 2 - 2, y, face);
      text_at([sx / 2, y - 15, 14], -9, "hp-company", line.company, piece("labels", 0));
      flange([sx + 5, y, 0], true, 0, piece("top", 0));
      tube(li === 0 ? [[sx, y, 0], [x_end, y, 0]] : [[sx, y, 0], ...join_of(li)], 1);
      lines.push({ inlet: [sx, y, 0], machines: [], next: 0, spawn_t: rand(0, SPAWN_S) });

      // machines, evenly spaced on the line
      const a = cx + 6, b = (li === 0 ? x_end : jx) - 64, n = Math.max(line.machines.length, 1);
      line.machines.forEach((d, mi) => {
        const k = 2 + machines.length;
        const xm = a + (b - a) * (mi + 0.5) / n;
        const yc = y - 6, x0 = xm - MW / 2, x1 = xm + MW / 2, y0 = yc - MH / 2, y1 = yc + MH / 2;
        const xin = x0 + 16, xout = x1 - 16, front = DB - DM / 2;
        const attrs = { "data-st": String(machines.length), "data-accent": d.accent };
        const back_g = piece("back", k, attrs), glass_g = piece("glass", k, attrs), house_g = piece("house", k, attrs);
        const label_g = piece("labels", k, attrs), top_g = piece("top", k, attrs);
        const glass_raise = el("g", { class: `hp-raise${d.building ? " is-scaffold" : ""}` }, glass_g);
        const back_raise = el("g", { class: `hp-raise${d.building ? " is-scaffold" : ""}` }, back_g);
        housing(x0, y0, x1, y1, DB, DM, back_raise, glass_raise);
        // branches back to the trunk
        tube([[xin, y, 0], [xin, y, front + 1]], k);
        tube([[xout, y, 0], [xout, y, front + 1]], k);
        // name and note above the roof
        const roof: P3 = [xm, y0, DB + DM / 2];
        text_at(roof, -9, "hp-mname", d.name, label_g);
        text_at(roof, -24, `hp-note${d.building ? " is-always" : ""}`, d.building ? TEXT.building : d.note, label_g);
        // mechanism, at the machine's depth (moves with the view)
        const mech = el("g", { class: "hp-mech" }, house_g);
        live_draw(() => mech.setAttribute("transform", `translate(${f(R.x * DB)} ${f(R.y * DB)})`));
        const m: Machine = {
          d, line: li, x: xm, y, yc, queue: [], cur: null, busy: 0, resting: [],
          in_route: new Route3([lines[li].inlet, [xin, y, 0], [xin, y, front], [xm, yc, DB]]),
          out_route: new Route3([[xm, yc, DB], [xout, yc, DB], [xout, y, front], [xout, y, 0], ...tail_of(li, xout + 0.01)]),
          tray_route: null, tray_floor: 0,
          groups: [back_g, glass_g, house_g, label_g, top_g], glass: glass_g, mech, flag: null, twin: null, bar: null, ports: [], cells: [], gate: null,
        };
        const parts = (p: P3, dy: number, i: number) => text_at(p, dy, "hp-part", d.parts[i] ?? "", label_g);
        if (d.kind === "match") {
          el("rect", { x: xm - 24, y: yc - 8, width: 16, height: 16, rx: 2, class: "hp-slot" }, mech);
          el("rect", { x: xm + 8, y: yc - 8, width: 16, height: 16, rx: 2, class: "hp-slot" }, mech);
          m.twin = el("g", { class: "hp-twin" }, mech);
          el("path", { d: "M-3.6 -3.6 H3.6 V3.6 H-3.6 Z" }, m.twin);
          m.twin.setAttribute("transform", `translate(${xm + 16} ${yc})`);
          parts([xm - 16, yc - 8, DB], -4, 0); parts([xm + 16, yc - 8, DB], -4, 1);
        } else if (d.kind === "align") {
          el("path", { d: `M${xm - 30} ${yc - 8} H${xm + 30} M${xm - 30} ${yc + 8} H${xm + 30}`, class: "hp-rail" }, mech);
          m.bar = el("rect", { x: xm - 30, y: yc - 15, width: 3, height: 30, rx: 1, class: "hp-bar" }, mech);
          m.twin = el("g", { class: "hp-twin" }, mech);
          el("path", { d: "M-3.6 -3.6 H3.6 V3.6 H-3.6 Z" }, m.twin);
          m.twin.setAttribute("transform", `translate(${xm} ${yc + 8})`);
          parts([x0 + 6, yc - 8, DB], 3, 0); parts([x0 + 6, yc + 8, DB], 3, 1);
          // the flag on the roof, raised when a pair does not line up
          m.flag = el("g", { class: "hp-flag" }, top_g);
          const fp: P3 = [x1 - 10, y0, DB];
          live_draw(() => { const q = proj(fp); m.flag!.setAttribute("transform", `translate(${f(q.x)} ${f(q.y)})`); });
          const mast = el("g", { class: "hp-flag-mast" }, m.flag);
          el("line", { x1: 0, y1: 0, x2: 0, y2: -20, class: "hp-flag-pole" }, mast);
          el("path", { d: "M0 -20 L11 -16 L0 -12 Z", class: "hp-flag-body" }, mast);
          m.flag = mast;
        } else if (d.kind === "query") {
          m.gate = el("rect", { x: xm - 22, y: yc - 11, width: 4, height: 22, rx: 1.5, class: "hp-gate" }, mech);
          for (let i = 0; i < 4; i++) m.ports.push(el("rect", { x: xm + 12, y: yc - 15 + i * 8, width: 14, height: 6, rx: 1, class: "hp-port" }, mech));
          parts([xm - 20, yc - 11, DB], -4, 0); parts([xm + 19, yc - 15, DB], -4, 1);
        } else if (d.kind === "stages") {
          for (let i = 0; i < 4; i++) {
            m.cells.push(el("rect", { x: x0 + 3 + i * (MW - 6) / 4, y: yc - 12, width: (MW - 6) / 4 - 2, height: 24, rx: 2, class: "hp-cell" }, mech));
            parts([x0 + 3 + (i + 0.5) * (MW - 6) / 4, yc - 12, DB], -4, i);
          }
        }
        if (d.outlet) {
          const t0 = x1 + 7, t1 = x1 + 31, ty0 = yc - 2, ty1 = yc + 20;
          tray(t0, ty0, t1, ty1, DB, 26, back_g, glass_g);
          m.tray_route = new Route3([[xm, yc, DB], [x1 - 4, yc - 10, DB], [(t0 + t1) / 2, yc - 12, DB], [(t0 + t1) / 2, ty1 - 6, DB]]);
          m.tray_floor = ty1 - 6;
          text_at([t1, ty1, DB - 13], 11, "hp-part hp-outlet", d.outlet, label_g);
        }
        machines.push(m);
        if (!d.building) lines[li].machines.push(m);
      });
    });
    // line 2 and later: drawn up to and into line 1 (one tube per line, from the source to the join)
    // k 1 tube for line 1 drawn above; the rise into the photo (or the tower) belongs to line 1's end
    if (inline) {
      const gl = piece("glass", 1);
      housing(px, Y - 58, px + 56, Y + 16, 0, 40, piece("back", 1), gl);
      text_at([px + 28, Y - 58, 20], -9, "hp-company", TEXT.result, piece("labels", 1));
    } else {
      tube([[x_end, Y, 0], ...bend([x_end, Y, 0], [px, Y, 0], [px, Y - 16, 0]), [px, top, 0]], 1, rise_tube);
      flange([px, Y - 24, 0], false, 1, el("g", {}, layers.rise));
    }

    scene = { machines, lines, loose: [] };
    hover_i = -1;
    if (reduce || inline) {
      for (let i = 0; i < 300; i++) step(1 / 30, true);
      render();
      if (inline) { const b = (cam_g as SVGGElement).getBBox(); svg.setAttribute("viewBox", `${f(b.x - 8)} ${f(b.y - 8)} ${f(b.width + 16)} ${f(b.height + 16)}`); }
      return;
    }
    drop.hidden = false;
    const at_drop = to_screen(cx + 40, ys[ys.length - 1] + 40);
    drop.style.left = `${f(at_drop.x)}px`;
    drop.style.top = `${f(at_drop.y)}px`;
    drop.style.maxWidth = `${f(W * 0.5)}px`;
    if (animate) {
      setTimeout(() => {
        if (id !== build_id) return;
        for (let k = 0; k < 6; k++) setTimeout(() => id === build_id && spawn(k % scene!.lines.length, true), k * 90);
        live = true;
        sync();
      }, ASSEMBLED_S * 1000);
    } else {
      for (let i = 0; i < 300; i++) step(1 / 30, true);
      render();
      live = true;
      sync();
    }
  }

  // ---------- simulation ----------
  // Packets that have left their machine (out to the photo, or down into the tray).
  const outs = new Set<Packet>();
  function new_packet(m: Machine, mine: boolean): Packet {
    return { g: make_packet(layers.packets, mine), m, leg: "in", s: 0, v: rand(0.85, 1.15) * V, a: rand(0, 360), spin: rand(-200, 200),
             mine, t: 0, outcome: "ok", off: { x: 0, y: 0 }, fx: 0, fy: 0, qx: 0, qy: 0, port: 0 };
  }
  function pick(line: Scene["lines"][number], force = false): Machine | null {
    for (let n = 0; n < line.machines.length; n++) {
      const m = line.machines[(line.next + n) % line.machines.length];
      if (force || m.queue.length < MAX_Q) { line.next = (line.next + n + 1) % line.machines.length; return m; }
    }
    return null;
  }
  // express: the first-visit opening batch runs at EXPRESS x speed so the photo assembles within a few seconds
  function spawn(li: number, express = false) {
    const line = scene?.lines[li], m = line && pick(line);
    if (!m) return;
    const p = new_packet(m, false);
    if (express) { p.v *= EXPRESS; p.express = true; }
    m.queue.push(p);
  }
  function drop_at(x: number, y: number) {
    if (!scene) return;
    const p0 = to_plane(x, y);
    let li = 0, best = Infinity;
    scene.lines.forEach((l, i) => { const d = Math.hypot(l.inlet[0] - p0.x, l.inlet[1] - p0.y); if (d < best && l.machines.length) { best = d; li = i; } });
    const line = scene.lines[li], m = pick(line, true);
    if (!m) return;
    const p = new_packet(m, true);
    Object.assign(p, { leg: "fly", fx: p0.x, fy: p0.y, qx: (p0.x + line.inlet[0]) / 2, qy: Math.min(p0.y, line.inlet[1]) - 110, v: 165, spin: 620 });
    scene.loose.push(p);
    follow = p;
    show_card(scene.machines.indexOf(m));
  }

  const bump = (node: Element | null, frames: Keyframe[], ms: number) =>
    node?.animate(frames, { duration: ms, easing: "cubic-bezier(0.34, 1.6, 0.64, 1)" });
  let last_pulse = 0;

  function begin(m: Machine, p: Packet, quiet: boolean) {
    m.cur = p; m.busy = PROC_S; p.leg = "proc"; p.t = 0; p.spin = 0;
    p.outcome = p.mine || p.express ? "ok" : m.d.kind === "query" ? (Math.random() < FAIL_P ? "fail" : "ok") : Math.random() < FLAG_P ? "flag" : "ok";
    p.port = Math.floor(Math.random() * 4);
    if (quiet) return;
    if (m.twin) {
      m.twin.classList.add("is-on");
      if (m.d.kind === "match") m.twin.animate([{ translate: "0 0" }, { translate: "0 0", offset: 0.35 }, { translate: "-26px 0" }], { duration: PROC_S * 1000, easing: "ease-in-out" });
    }
    if (m.bar) m.bar.animate([{ translate: "0 0" }, { translate: "57px 0" }], { duration: PROC_S * 900, easing: "ease-in-out" });
    if (m.gate) bump(m.gate, [{ translate: "0 0" }, { translate: "0 -16px", offset: 0.3 }, { translate: "0 0" }], 360);
  }
  function finish(m: Machine, p: Packet, quiet: boolean) {
    m.cur = null; m.twin?.classList.remove("is-on");
    for (const c of m.cells) c.classList.remove("is-on");
    for (const c of m.ports) c.classList.remove("is-on");
    p.off = { x: 0, y: 0 };
    outs.add(p);
    if (p.outcome === "flag" && m.tray_route) {
      p.leg = "tray"; p.s = 0; p.g.classList.add("is-flagged");
      if (!quiet && m.flag) bump(m.flag, [{ scale: "1 0" }, { scale: "1 1", offset: 0.2 }, { scale: "1 1", offset: 0.8 }, { scale: "1 0" }], 1600);
      return;
    }
    p.leg = "out"; p.s = 0; p.a = 0;
    p.g.setAttribute("data-accent", m.d.accent);
    if (p.outcome === "fail") p.g.classList.add("is-failed");
    set_clean(p.g);
  }

  function step(dt: number, quiet: boolean) {
    const sc = scene!;
    for (let li = 0; li < sc.lines.length; li++) {
      const line = sc.lines[li];
      if (!line.machines.length) continue;
      line.spawn_t += dt;
      const every = SPAWN_S * (li === 0 ? 1 : 2.2);
      if (line.spawn_t >= every) { line.spawn_t = 0; spawn(li); }
    }
    // visitor packets flying to their line
    for (let k = 0; k < sc.loose.length; k++) {
      const p = sc.loose[k];
      p.t = Math.min(p.t + dt / 0.55, 1);
      p.a += p.spin * dt;
      if (p.t >= 1) { sc.loose.splice(k--, 1); p.leg = "in"; p.s = 0; p.v = V * 1.5; p.m.queue.push(p); }
    }
    for (const m of sc.machines) {
      // queue on the way in: first come, first served; packets bunch up behind each other
      m.queue.forEach((p, k) => {
        const head = m.cur ? 1 : 0;
        const limit = k === 0 && !m.cur ? m.in_route.length : (k === 0 ? m.in_route.length - GAP * head : m.queue[k - 1].s - GAP);
        p.s = Math.max(p.s, Math.min(p.s + p.v * dt, limit));
        if (p.s < m.in_route.length - 30) p.a += p.spin * dt;
      });
      if (!m.cur && m.queue[0] && m.queue[0].s >= m.in_route.length - 0.5) begin(m, m.queue.shift()!, quiet);
      // processing: the mechanism runs, the packet moves inside the machine
      if (m.cur) {
        const p = m.cur;
        p.t += dt;
        const u = Math.min(p.t / PROC_S, 1);
        if (m.d.kind === "match") p.off = { x: -16, y: 0 };
        else if (m.d.kind === "align") p.off = { x: -24 + 48 * u, y: -8 };
        else if (m.d.kind === "query") {
          p.off = { x: u < 0.4 ? -24 + 30 * (u / 0.4) : 6, y: u < 0.4 ? 0 : (-15 + p.port * 8 + 3) * Math.min((u - 0.4) / 0.2, 1) };
          if (!quiet) m.ports.forEach((c, i) => c.classList.toggle("is-on", u > 0.5 && i === p.port));
        } else if (m.d.kind === "stages") {
          const cell = Math.min(3, Math.floor(u * 4));
          p.off = { x: -MW / 2 + 3 + (cell + 0.5) * (MW - 6) / 4, y: 0 };
          if (!quiet) m.cells.forEach((c, i) => c.classList.toggle("is-on", i === cell));
        }
        if (p.t >= PROC_S) finish(m, p, quiet);
      }
    }
    // packets leaving: out to the photo, or down into the tray
    for (const p of [...outs]) {
      const m = p.m;
      {
        if (p.leg === "out") {
          p.s += p.v * dt;
          if (p.s >= m.out_route.length) {
            p.leg = "rest"; p.g.remove(); outs.delete(p);
            if (follow === p) end_follow();
            if (!quiet) photo.arrive(m.d.accent);
            const now = performance.now();
            if (!quiet && !inline && now - last_pulse > 220) { last_pulse = now; bump(blob, [{ scale: "1" }, { scale: "1.045" }, { scale: "1" }], 420); }
          }
        } else if (p.leg === "tray") {
          p.s += p.v * 0.8 * dt;
          if (p.s >= m.tray_route!.length) {
            p.leg = "rest"; outs.delete(p);
            if (follow === p) end_follow();
            m.resting.push(p);
            p.off = { x: (m.resting.length % 3 - 1) * 7, y: 0 };
            if (m.resting.length > MAX_TRAY) {
              const old = m.resting.shift()!;
              if (quiet) old.g.remove(); else old.g.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 300 }).onfinish = () => old.g.remove();
            }
          }
        }
      }
    }
  }

  function render() {
    const sc = scene!;
    for (const m of sc.machines) {
      for (const p of m.queue) { const q = m.in_route.at(p.s); place(p.g, q.x, q.y, p.a); }
      if (m.cur) { const q = m.in_route.at(m.in_route.length); place(m.cur.g, q.x + m.cur.off.x, q.y + m.cur.off.y, 0); }
      for (const p of m.resting) { const q = m.tray_route!.at(m.tray_route!.length); place(p.g, q.x + p.off.x, q.y, p.a); }
    }
    for (const p of outs) {
      const r = p.leg === "tray" ? p.m.tray_route! : p.m.out_route, q = r.at(p.s);
      place(p.g, q.x, q.y, p.leg === "tray" ? p.a : 0);
    }
    for (const p of sc.loose) {
      const inlet = proj(p.m.in_route.point(0)), u = 1 - p.t;
      place(p.g, u * u * p.fx + 2 * u * p.t * p.qx + p.t * p.t * inlet.x, u * u * p.fy + 2 * u * p.t * p.qy + p.t * p.t * inlet.y, p.a);
    }
  }

  // ---------- camera (clipped to the pipeline band, so the text above never moves) ----------
  let cam_g: Element | null = null;
  let band = { top: 0, bottom: 0, width: 0 };
  const HOVER_S = 2.1;                           // hover magnification (labels keep their size, so they spread apart)
  let rise_clip: Element | null = null;
  let cam = { x: 0, y: 0, s: 1 }, cam_goal = { x: 0, y: 0, s: 1 };
  let follow: Packet | null = null;
  function band_center() { const vb = svg!.viewBox.baseVal; return { x: vb.width * 0.5, y: Math.min(vb.height - 70, (scene ? scene.machines[0]?.y ?? 0 : 0) + 20) }; }
  function aim(p: { x: number; y: number }, s: number) { const c = band_center(); cam_goal = { s, x: c.x - s * p.x, y: c.y - s * p.y }; }
  function end_follow() { follow = null; cam_goal = { x: 0, y: 0, s: 1 }; if (hover_i < 0 && card) card.hidden = true; }
  function packet_screen(p: Packet) {
    const m = p.m;
    if (p.leg === "fly") return to_screen(p.fx, p.fy);
    if (p.leg === "proc") { const q = m.in_route.at(m.in_route.length); return to_screen(q.x + p.off.x, q.y + p.off.y); }
    const r = p.leg === "out" ? m.out_route : p.leg === "tray" ? m.tray_route! : m.in_route, q = r.at(p.s);
    return to_screen(q.x, q.y);
  }
  function cam_step() {
    if (follow) {
      // follow until the packet starts its rise (the rise sits outside the band)
      if (follow.leg === "out" && follow.s > follow.m.out_route.length - 90) end_follow();
      else if (follow) aim(packet_screen(follow), 1.9);
    }
    const k = 0.1;
    cam.x += (cam_goal.x - cam.x) * k; cam.y += (cam_goal.y - cam.y) * k; cam.s += (cam_goal.s - cam.s) * k;
    cam_g?.setAttribute("transform", `translate(${f(cam.x)} ${f(cam.y)}) scale(${cam.s.toFixed(4)})`);
    const zoomed = cam.s > 1.03;
    svg?.classList.toggle("is-zoomed", zoomed);
    svg?.style.setProperty("--cam-s", cam.s.toFixed(4));    // labels divide their size by this, so text stays put
    if (hover_i >= 0 && card && !card.hidden) place_card(hover_i);
    rise_clip?.setAttribute("visibility", zoomed ? "hidden" : "visible");
  }

  // ---------- hover: open the machine, show its project ----------
  let hover_i = -1;
  let hover_rect: DOMRect | null = null;          // the hovered machine before zooming: keeps it hovered while it grows
  const inside = (x: number, y: number, b: DOMRect | null) => !!b && x >= b.left - 6 && x <= b.right + 6 && y >= b.top - 30 && y <= b.bottom + 6;
  function machine_at(x: number, y: number): number {
    if (!scene) return -1;
    if (hover_i >= 0 && (inside(x, y, hover_rect) || inside(x, y, scene.machines[hover_i].glass.getBoundingClientRect()))) return hover_i;
    if (cam.s > 1.03 && !follow) return -1;      // leaving a magnified machine: zoom back out before picking another
    let found = -1;
    scene.machines.forEach((m, i) => {
      const b = m.glass.getBoundingClientRect();
      if (x >= b.left - 6 && x <= b.right + 6 && y >= b.top - 30 && y <= b.bottom + 6) found = i;
    });
    return found;
  }
  function show_card(i: number) {
    if (!card || !scene || !hero) return;
    const m = scene.machines[i];
    if (!m) { card.hidden = true; return; }
    const d = m.d;
    card.dataset.accent = d.accent;
    card.querySelector(".hmc-title")!.textContent = d.title;
    card.querySelector<HTMLElement>(".hmc-core")!.hidden = !d.core;
    card.querySelector(".hmc-core-text")!.textContent = d.core;
    card.querySelector(".hmc-before")!.textContent = d.before;
    card.querySelector(".hmc-after")!.textContent = d.after;
    card.querySelector(".hmc-go")!.textContent = d.building ? `${TEXT.building} · ${TEXT.open}` : TEXT.open;
    card.hidden = false;
    place_card(i);
  }
  // beside the machine (as it is drawn now, zoomed or not): to its right, or to its left when there is no room
  function place_card(i: number) {
    const m = scene?.machines[i];
    if (!card || !m || !hero) return;
    const hb = hero.getBoundingClientRect(), gb = m.glass.getBoundingClientRect();
    let left = gb.right - hb.left + 14;
    if (left + card.offsetWidth > hb.width - 8) left = gb.left - hb.left - card.offsetWidth - 14;
    card.style.left = `${f(Math.max(8, left))}px`;
    card.style.top = `${f(gb.top - hb.top - 6)}px`;
  }
  function set_hover(i: number) {
    if (i === hover_i || !scene) return;
    hover_i = i;
    scene.machines.forEach((m, k) => m.groups.forEach((g) => g.classList.toggle("is-open", k === i)));
    if (hero) hero.style.cursor = i >= 0 ? "pointer" : "";
    hover_rect = i >= 0 ? scene.machines[i].glass.getBoundingClientRect() : null;
    if (i >= 0) show_card(i); else if (!follow && card) card.hidden = true;
    // Magnify the hovered machine in place (kept inside the band, clear of the text above), so its labels separate.
    if (follow || reduce) return;
    if (i < 0) { cam_goal = { x: 0, y: 0, s: 1 }; return; }
    const m = scene.machines[i], c = to_screen(m.x + R.x * DB, m.yc + R.y * DB), s = HOVER_S;
    const tx = Math.min(Math.max(c.x, 75 * s + 10), band.width - 80 * s - 10);
    const ty = Math.min(Math.max(c.y, band.top + 52 * s + 24), band.bottom - 44 * s - 14);
    cam_goal = { s, x: tx - s * c.x, y: ty - s * c.y };
  }
  function fly_into(i: number) {
    const m = scene?.machines[i];
    if (!m || !hero) return;
    try { sessionStorage.setItem("machine-fly", m.d.area); } catch { /* storage blocked: the case study still opens */ }
    if (reduce) { location.href = m.d.href; return; }
    follow = null;
    if (card) card.hidden = true;
    aim(to_screen(m.x + R.x * DB, m.yc + R.y * DB), 2.6);
    // a box over the zoomed machine carries the page transition's name, so the case study's machine grows out of it
    setTimeout(() => {
      const b = m.glass.getBoundingClientRect(), hb = hero.getBoundingClientRect();
      const ghost = document.createElement("div");
      ghost.className = "machine-fly-ghost";
      Object.assign(ghost.style, { left: `${b.left - hb.left}px`, top: `${b.top - hb.top}px`, width: `${b.width}px`, height: `${b.height}px` });
      hero.appendChild(ghost);
      location.href = m.d.href;
    }, 620);
  }

  // ---------- loop ----------
  let raf = 0, last = 0, running = false, live = false, on_screen = true;
  function frame(now: number) {
    step(Math.min((now - last) / 1000, 0.05), false);
    last = now;
    render();
    cam_step();
    raf = requestAnimationFrame(frame);
  }
  function stop() { running = false; live = false; cancelAnimationFrame(raf); }
  function sync() {
    const go = live && scene && on_screen && !document.hidden && !reduce && !inline;
    if (go && !running) { running = true; last = performance.now(); raf = requestAnimationFrame(frame); }
    else if (!go && running) { running = false; cancelAnimationFrame(raf); }
  }

  // First visit: the headline, then the title, assemble from characters scattered across the text column, each
  // landing with a stamp-coloured pop ("data scattered across systems, joined up"). The intro paragraph stays still
  // so it can be read at once. Measured after build(), which sets the hero's final padding.
  function assemble_text() {
    const root = document.documentElement;
    const head = hero?.querySelector<HTMLElement>(".hero-statement");
    const role = hero?.querySelector<HTMLElement>(".hero-role > .mono");
    if (!hero || !head || !role) { root.classList.remove("ts-pending"); return; }
    head.classList.add("ts-hide");
    role.classList.add("ts-hide");
    root.classList.remove("ts-pending");
    const show = () => { head.classList.remove("ts-hide"); role.classList.remove("ts-hide"); };
    try {
      const tokens = getComputedStyle(root), tok = (name: string) => tokens.getPropertyValue(name).trim();
      const box = hero.getBoundingClientRect(), col = hero.querySelector<HTMLElement>(".hero-text")!.getBoundingClientRect();
      const common = {
        host: hero, raw_color: tok("--muted"), stamp_color: tok("--accent-2"),
        area: { left: 0, top: 0, right: Math.min(box.width, col.right - box.left + 40), bottom: box.height - 24 },
      };
      const a = assemble(head, { ...common, start_ms: 250, spread_ms: 1800, max_stagger_ms: 40, duration_ms: 720, final_color: tok("--fg") });
      const b = assemble(role, { ...common, start_ms: 2300, spread_ms: 600, max_stagger_ms: 24, duration_ms: 520, final_color: tok("--muted") });
      a.done.then(() => head.classList.remove("ts-hide"));
      b.done.then(() => role.classList.remove("ts-hide"));
      // A resize mid-flight would leave clones at stale positions: land everything at once.
      window.addEventListener("resize", () => { a.finish(); b.finish(); }, { once: true });
    } catch { show(); }
  }

  if (svg && hero && drop) {
    const first_run = !reduce && !document.documentElement.classList.contains("hero-seen");
    document.fonts.ready.then(() => {
      const wrap = hero.querySelector<HTMLElement>(".hero-photo");
      if (first_run && wide.matches && wrap) {
        const live_projects = new Set(LINES.flatMap((l) => l.machines.filter((m) => !m.building).map((m) => m.accent)));
        photo = assemble_photo(wrap, live_projects.size, PHOTO_DEADLINE_S * 1000);
      }
      build(first_run && wide.matches);
      if (document.documentElement.classList.contains("ts-pending")) assemble_text();
      let built_w = hero.getBoundingClientRect().width;
      new ResizeObserver(() => {
        const w = hero.getBoundingClientRect().width;
        if (Math.abs(w - built_w) > 1) { built_w = w; build(false); }
      }).observe(hero);
      wide.addEventListener("change", () => build(false));
      new IntersectionObserver(([e]) => { on_screen = e.isIntersecting; sync(); }).observe(hero);
      document.addEventListener("visibilitychange", sync);
    });
    // Visitors drop their own packet: the button (keyboard), or a click on any empty spot of the hero.
    drop.addEventListener("click", () => {
      const b = drop.getBoundingClientRect(), box = hero.getBoundingClientRect();
      drop_at(b.left - box.left + 14, b.top - box.top + b.height / 2);
    });
    hero.addEventListener("click", (e) => {
      if (inline || (e.target as Element).closest("a, button, input, select, textarea, label")) return;
      if (String(window.getSelection() ?? "").length) return;
      const hit = machine_at(e.clientX, e.clientY);
      if (hit >= 0) { fly_into(hit); return; }
      if (!running) return;
      const box = hero.getBoundingClientRect();
      drop_at(e.clientX - box.left, e.clientY - box.top);
    });
    hero.addEventListener("pointermove", (e) => {
      if (inline || (e.target as Element).closest("a, button")) { set_hover(-1); return; }
      set_hover(machine_at(e.clientX, e.clientY));
    });
    hero.addEventListener("pointerleave", () => set_hover(-1));
    // Moving across the hero turns the drawing a little (and the stacked sheets of the hero buttons with it).
    tilt(hero, (v) => {
      if (inline) return;
      if (scene) set_view(v);
      set_layer_tilt(hero, v);
    });
  }
</script>
