---
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";
import ContactLinks from "../components/ContactLinks.astro";
import { get_profile } from "../i18n/profile";
import { html_lang, lang_path, use_translations, type Lang } from "../i18n/ui";
import { url } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  // Path (without deploy base) of this page in the other language; defaults to the same path with/without "/en".
  // Pages that exist in one language only (zh case studies) point it at the closest page, e.g. "/en/projects/".
  alt_path?: string;
}

const { lang = "zh", alt_path } = Astro.props;
const profile    = get_profile(lang);
const t          = use_translations(lang);
const { title, description = profile.tagline } = Astro.props;
const page_title = title ? `${title} — ${profile.name}` : `${profile.name} | ${profile.title}`;
const full_path  = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const path       = full_path.replace(/^\/en(\/|$)/, "/");   // same path in both languages, e.g. "/about/"
const other_path = alt_path ?? (lang === "en" ? path : `/en${path}`);
// Social preview (LinkedIn, Slack, messaging apps). public/og.png is generated from scripts/og/og.html.
// Astro.site is set on GitHub Actions builds; locally it falls back to the dev URL so the tags still render.
const site_root  = Astro.site ?? Astro.url;
const page_url   = new URL(Astro.url.pathname, site_root).href;
const og_image   = new URL(url("og.png"), site_root).href;

const nav = [
  { href: lang_path("/", lang),          label: "Home",     active: path === "/" },
  { href: lang_path("about/", lang),     label: "About",    active: path.startsWith("/about") },
  { href: lang_path("projects/", lang),  label: "Projects", active: path.startsWith("/projects") },
  { href: lang_path("contact/", lang),   label: "Contact",  active: path.startsWith("/contact") },
];
---

<!doctype html>
<html lang={html_lang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page_title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={page_url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={page_title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={page_url} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "zh_TW"} />
    <meta property="og:image" content={og_image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} · ${profile.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      // Saved choice (header toggle) wins; otherwise follow the OS preference.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("theme"); } catch (e) {}
        var system = window.matchMedia("(prefers-color-scheme: dark)");
        document.documentElement.dataset.theme = saved || (system.matches ? "dark" : "light");
        system.addEventListener("change", function (e) {
          var still_saved = null;
          try { still_saved = localStorage.getItem("theme"); } catch (err) {}
          if (still_saved) return;
          document.documentElement.dataset.theme = e.matches ? "dark" : "light";
          window.dispatchEvent(new Event("themechange"));
        });
      })();
    </script>
    <!-- Cross-page transition opt-in, inline so it is parsed with the document (an external stylesheet can arrive
         after Chrome decides). Only machine clicks keep the transition; see the script below. -->
    <style is:inline>@view-transition { navigation: auto; }</style>
    <script is:inline>
      // Flying into a case study from a Home machine: the Home page sets this flag and adds a box named
      // "machine-fly" over the zoomed machine; the case study's machine (.from-machine .machine-view) takes the same
      // name, so the page transition grows it out of that box. Every other navigation skips the transition.
      try {
        if (sessionStorage.getItem("machine-fly")) {
          document.documentElement.classList.add("from-machine");
          sessionStorage.removeItem("machine-fly");
          setTimeout(() => document.documentElement.classList.remove("from-machine"), 1500);
        }
      } catch { /* storage blocked: no transition */ }
      addEventListener("pageswap", (e) => {
        if (e.viewTransition && !document.querySelector(".machine-fly-ghost")) e.viewTransition.skipTransition();
      });
    </script>
  </head>
  <body>
    <!-- Shared SVG filter: gives a shape blueprint thickness (stacked copies of its outline toward the upper right,
         the same direction as the stacked sheets behind cards). Used by system-map nodes via CSS. -->
    <svg class="svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="bp-extrude" x="-5%" y="-25%" width="115%" height="135%" color-interpolation-filters="sRGB">
        <feOffset in="SourceAlpha" dx="1" dy="-1" result="o1" />
        <feOffset in="SourceAlpha" dx="2" dy="-2" result="o2" />
        <feOffset in="SourceAlpha" dx="3" dy="-3" result="o3" />
        <feOffset in="SourceAlpha" dx="4" dy="-4" result="o4" />
        <feMerge result="stack"><feMergeNode in="o1" /><feMergeNode in="o2" /><feMergeNode in="o3" /><feMergeNode in="o4" /></feMerge>
        <feFlood class="bp-extrude-side" result="side" />
        <feComposite in="side" in2="stack" operator="in" result="sides" />
        <feMorphology in="o4" operator="erode" radius="1" result="o4-in" />
        <feComposite in="o4" in2="o4-in" operator="out" result="ring" />
        <feFlood class="bp-extrude-edge" result="edge" />
        <feComposite in="edge" in2="ring" operator="in" result="back-line" />
        <feMerge><feMergeNode in="sides" /><feMergeNode in="back-line" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </svg>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={lang_path("/", lang)}>
          <BrandMark />
          <span class="brand-name">{profile.name}</span>
        </a>
        <div class="header-right">
          <nav aria-label="Main">
            {nav.map((item) => (
              <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}</a>
            ))}
          </nav>
          <a class="lang-switch mono" href={url(other_path)} hreflang={html_lang[lang === "en" ? "zh" : "en"]}
             aria-label={t("lang.switch_label")} title={t("lang.switch_label")}>{t("lang.switch")}</a>
          <button class="theme-toggle" type="button" aria-label={t("theme.toggle")} title={t("theme.toggle")}>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span class="mono muted">© {new Date().getFullYear()} {profile.name} · {profile.title}</span>
        <ContactLinks compact />
      </div>
    </footer>

    <script>
      // Header sun/moon toggle: flip the theme, remember it, and notify listeners (e.g. Mermaid re-render).
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch { /* storage blocked: theme still switches for this page */ }
        window.dispatchEvent(new Event("themechange"));
      });
    </script>
  </body>
</html>
