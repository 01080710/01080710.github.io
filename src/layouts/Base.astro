---
import "../styles/global.css";
import ContactLinks from "../components/ContactLinks.astro";
import { profile } from "../data/profile";
import { url } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.tagline } = Astro.props;
const page_title = title ? `${title} — ${profile.name}` : `${profile.name} | ${profile.title}`;
const path       = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";

const nav = [
  { href: url("/"),          label: "Home",     active: path === "/" },
  { href: url("about/"),     label: "About",    active: path.startsWith("/about") },
  { href: url("projects/"),  label: "Projects", active: path.startsWith("/projects") },
  { href: url("/#contact"),  label: "Contact",  active: false },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page_title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={url("/")}>
          <span class="brand-mark">PC</span>
          <span class="brand-name">{profile.name}</span>
        </a>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span class="mono muted">© {new Date().getFullYear()} {profile.name} · {profile.title}</span>
        <ContactLinks compact />
      </div>
    </footer>
  </body>
</html>
