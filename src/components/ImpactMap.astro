---
// Home impact map: per company, the system map with every project lit in its own accent and one card per project
// under it (before -> after, plus up to 2 `on_home` metrics). A dropdown picks the company. Numbers and text come
// from the project files; companies come from each project's `system_map.map` and `company`.
// Hovering or focusing a card dims the other areas of the map (CSS :has, no JS needed).
import SystemMap from "./SystemMap.astro";
import { get_impact_projects } from "../i18n/projects";
import { lang_path, use_translations, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = use_translations(lang);

const projects = await get_impact_projects(lang);
// One group per company map, in order of first appearance; the company name comes from the projects' `company`.
const groups = [...new Set(projects.map((p) => p.data.system_map!.map))].map((map) => {
  const items = projects.filter((p) => p.data.system_map!.map === map);
  return {
    map,
    company: items[0].data.company,
    items,
    accents: Object.fromEntries(items.map((p) => [p.data.system_map!.area, p.data.accent])),
    building: items.filter((p) => !p.data.home).map((p) => p.data.system_map!.area),
  };
});
// Company control scales with the number of companies: 1 = none (name goes in the title),
// 2-4 = tabs, 5+ = dropdown. Short name drops the legal suffix, e.g. "海科科技有限公司" -> "海科科技".
const short_name = (name: string) => name.replace(/(股份)?有限公司$|,?\s*(Co\.,?\s*)?Ltd\.?$/i, "").trim();
const picker = groups.length === 1 ? "none" : groups.length <= 4 ? "tabs" : "select";
---

<section class="section impact-map" aria-labelledby="impact-map-title">
  <h2 class="section-title" id="impact-map-title">
    {t("home.map_title")}{picker === "none" && <span class="impact-map-company"> · {short_name(groups[0].company)}</span>}
  </h2>
  <p class="muted section-note">{t("home.map_note")}</p>

  <!-- Company picker (2+ companies): revealed by the script below. Without JS every company is shown in turn. -->
  {picker === "tabs" && (
    <div class="impact-toolbar impact-tabs" role="tablist" aria-label={t("home.map_company")} hidden>
      {groups.map((g) => (
        <button type="button" role="tab" class="impact-tab" id={`impact-tab-${g.map}`}
                aria-controls={`impact-panel-${g.map}`} data-company={g.map}>{short_name(g.company)}</button>
      ))}
    </div>
  )}
  {picker === "select" && (
    <div class="impact-toolbar" hidden>
      <label for="impact-company" class="mono">{t("home.map_company")}</label>
      <span class="impact-select-wrap">
        <select id="impact-company" class="impact-select">
          {groups.map((g) => <option value={g.map}>{short_name(g.company)}</option>)}
        </select>
      </span>
    </div>
  )}

  {groups.map((g) => (
    <div class="impact-company" data-company={g.map} id={`impact-panel-${g.map}`}
         role={picker === "tabs" ? "tabpanel" : undefined}
         aria-labelledby={picker === "tabs" ? `impact-tab-${g.map}` : undefined}>
      {picker !== "none" && <p class="impact-company-name">{g.company}</p>}
      <!-- Open by default (no-JS readers get the map). The script below closes it on narrow screens, where the
           wide map would only scroll sideways; the cards carry the same content. -->
      <details class="impact-map-details" open>
        <summary class="mono">{t("home.map_show")}</summary>
        <SystemMap map={g.map} accents={g.accents} building={g.building} lang={lang} />
      </details>
      <ul class="impact-cards">
        {g.items.map((p) => (
          <li class:list={["impact-card", { "is-building": !p.data.home }]} data-accent={p.data.accent} data-area={p.data.system_map!.area}>
            <a href={lang_path(`projects/${p.id}/`, lang)}>
              <span class="impact-card-head">
                <span class="system-map-key" aria-hidden="true"></span>
                <span class="impact-card-title">{p.data.title}</span>
                {!p.data.home && <span class="impact-badge mono">{t("home.building")}</span>}
              </span>
              <dl class="impact-ba">
                <div><dt class="mono">{t("home.before")}</dt><dd>{p.data.impact!.before}</dd></div>
                <div><dt class="mono">{t("home.after")}</dt><dd>{p.data.impact!.after}</dd></div>
              </dl>
              {p.data.home && p.data.metrics.some((m) => m.on_home) && (
                <dl class="impact-nums">
                  {p.data.metrics.filter((m) => m.on_home).map((m) => (
                    <div><dt class="mono">{m.value}</dt><dd>{m.label}</dd></div>
                  ))}
                </dl>
              )}
              <span class="read-more mono">{t("card.read_more")}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>

<script>
  // Company picker (tabs for 2-4 companies, dropdown for 5+): one company's map and cards at a time.
  // The choice is remembered for this visitor only. With a single company there is no picker at all.
  const KEY    = "impact-company";
  const panels = [...document.querySelectorAll<HTMLElement>(".impact-company")];
  const tabs   = [...document.querySelectorAll<HTMLButtonElement>(".impact-tab")];
  const select = document.querySelector<HTMLSelectElement>("#impact-company");
  const toolbar = document.querySelector<HTMLElement>(".impact-toolbar");
  if (toolbar && panels.length > 1) {
    const show = (map: string) => {
      for (const p of panels) p.hidden = p.dataset.company !== map;
      for (const tab of tabs) {
        const on = tab.dataset.company === map;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
      }
      if (select) select.value = map;
      try { localStorage.setItem(KEY, map); } catch { /* storage blocked: the choice just isn't remembered */ }
    };
    let start = panels[0].dataset.company!;
    try {
      const saved = localStorage.getItem(KEY);
      if (saved && panels.some((p) => p.dataset.company === saved)) start = saved;
    } catch { /* ignore */ }
    toolbar.hidden = false;
    document.documentElement.classList.add("has-impact-picker");
    show(start);
    select?.addEventListener("change", () => show(select.value));
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => show(tab.dataset.company!));
      // Arrow keys move between tabs (WAI-ARIA tabs pattern).
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        next.focus();
        show(next.dataset.company!);
      });
    });
  }

  // Narrow screens: start with the system map collapsed; wide screens: always open (the summary is hidden by CSS).
  const wide = matchMedia("(min-width: 641px)");
  const sync_map = () => {
    for (const d of document.querySelectorAll<HTMLDetailsElement>(".impact-map-details")) d.open = wide.matches;
  };
  sync_map();
  wide.addEventListener("change", sync_map);
</script>
