---
// Company system map: where each project sits in the money flow.
// Redrawn from Peter's internal diagram (canva-export/structure.png) with the brand name removed.
// `area` highlights one project's part of the map; the rest is dimmed.
// To add a company later: add its map name to the schema enum and a new branch below.
import { use_translations, type Lang } from "../i18n/ui";
import { map_crops, map_tags, type MapArea, type MapName } from "../data/system-maps";
import { lang_path } from "../i18n/ui";

type Area = MapArea;
interface Props {
  map: MapName;
  // One project's area (case study pages). Omit for the overview (Home impact map): every area is lit.
  area?: Area;
  // Overview only: each area's project accent (frontmatter `accent`), so the map matches the cards below it.
  accents?: Partial<Record<Area, string>>;
  // Overview only: areas whose project is still in progress (drawn faded with dashed outlines).
  building?: Area[];
  lang?: Lang;
}
const { map, area, accents = {}, building = [], lang = "zh" } = Astro.props;
const overview = !area;
// Case study pages show a zoomed crop of their own area; Home shows the whole map.
const view_box = area ? (map_crops[map][area] ?? "0 0 960 484") : (map === "weishuo" ? "0 0 960 325" : "0 0 960 484");
const tags = map_tags[lang];
// Where each area's tag sits in the 960x484 viewBox (overview only).
const tag_at: Record<Area, { x: number; y: number }> = {
  "credit-card": { x: 110, y: 116 },
  "ticket":      { x: 317, y: 240 },
  "account":     { x: 480, y: 376 },
  "drop-order":  { x: 680, y: 228 },
};
const t = use_translations(lang);

const area_labels = {
  zh: {
    "ticket":      "Freshservice 工單 → 每年一檔 SQLite → OP 依群組分頁的 Excel",
    "credit-card": "信用卡 PSP ↔ CRM 的退款金額",
    "drop-order":  "CRM ↔ CPS 的出入金狀態與各渠道",
    "account":     "CRM 帳戶 ↔ MetaTrader 的帳戶狀態",
    "noise-enforcement": "設備主檔 → 天候查證 → 事件審核 → 稽核儀表板",
  },
  en: {
    "ticket":      "Freshservice tickets → yearly SQLite → per-group Excel for OP",
    "credit-card": "Refund amounts between the credit card PSP and CRM",
    "drop-order":  "Deposit and withdrawal statuses between CRM, CPS and each channel",
    "account":     "Account statuses between CRM accounts and MetaTrader",
    "noise-enforcement": "Device records → weather evidence → event review → audit dashboard",
  },
};
const area_label = area ? area_labels[lang][area] : "";
const uid = `sysmap-${map}-${area ?? "all"}`;   // unique per page even when several maps are shown
const svg_text = lang === "en"
  ? { title: "Money flow and system map",
      desc:  "Clients enter the CRM through the Client Portal; deposits and withdrawals go through CPS to each payment channel; card payments start in the Client Portal, and credit card recharges and refunds go through Bridger to Payabl; CRM accounts map to MetaTrader trading accounts, and account status is read from the CRM back office of each of 4 regulators; Freshservice tickets are handled by OP groups or dispatched to 11 other teams and closed out by OP; OP group tickets are synced daily into a yearly SQLite data mart.",
      serial: "Serial no.", groups: "OP handling groups", mart: "SQLite · one file per year", dispatch: "dispatch / close", other: "Other teams (11)", not_yet: "not synced yet", backoffice: "Back offices × 4", per_reg: "one per regulator" }
  : { title: "海科科技的資金流與系統地圖",
      desc:  "客戶經 Client Portal 進入 CRM；入金與出金經 CPS 連到各支付渠道；客戶在 Client Portal 刷卡，信用卡充值（Recharge）與退款（Refunded）經 Bridger 連到 Payabl；CRM 帳戶對應 MetaTrader 交易帳戶，帳戶狀態分別在 4 個 regulator 的 CRM 後台查詢；Freshservice 工單由 OP 的處理群組處理，或派給 11 個轉派部門後由 OP 收口；OP 群組的工單每日同步到每年一檔的 SQLite。",
      serial: "流水號", groups: "OP 處理群組", mart: "SQLite · 每年一檔", dispatch: "派單／收口", other: "轉派部門（11）", not_yet: "尚未納入擷取", backoffice: "CRM 後台 × 4", per_reg: "每個 regulator 一套" };
// Noise camera enforcement (weishuo): a "spine" diagram. One event's main path runs left to right
// (site -> event DB -> review API -> dashboard); the device & site management API and the image team join from
// above (master data and plates), weather evidence feeds the review, outputs leave below,
// so every arrow points right or down. Each connector is labelled with the data it carries. Base = others' parts; the area = Peter's four services, each tagged with
// the case study's stage word (measured / verified / judged / seen), without numbers so they never clash with chapter numbers. Column centres 100 / 285 / 470 / 655 / 840, nodes 140 wide, viewBox 960x325.
const ws = lang === "en"
  ? { title: "Noise camera enforcement: data flow",
      desc:  "Roadside sites (noise meter, anemometer, cameras) write their readings into the event database; the device and site management API maintains site, device and calibration records in the same database; the image team's recognition adds plates; weather evidence from CODiS supports the event review API, where reviewers judge each event valid or invalid; judgements feed the audit dashboard and the existing C# generator that produces inspection work orders for the environmental agency.",
      site: "Roadside site", site_s: "meters · cameras", db: "Event database", db_s: "main · history",
      img: "Image recognition", img_s: "image processing team", codis: "CODiS", codis_s: "CWA observation data",
      cs: "Work order generator", cs_s: "existing C# program", gov: "Agency", gov_s: "environmental protection",
      api: "Device & site mgmt", api_s: "master data · live", wx: "Weather evidence", wx_s: "crawler · Weather AI",
      rev: "Event review API", rev_s: "valid / invalid", dash: "Audit dashboard", dash_s: "hotspots · hours",
      wo: "Work order", wo_s: "existing C# generator",
      stages: ["Measured", "Verified", "Judged", "Seen"],
      mine: "My part", others: "Other teams / external",
      edge: { readings: "readings", writes: "site & device records", events: "events", verdicts: "verdicts", imagery: "plates, imagery",
              obs: "observations", wx: "road, wind, rain", valid: "valid events", insight: "insights", sent: "sent" } }
  : { title: "聲音照相科技執法的資料流",
      desc:  "路邊站點（噪音計、風速計、攝影機）把量測值寫入事件資料庫；設備與場域管理 API 在同一個資料庫維護站點、設備與校正紀錄主檔；影像處理團隊的辨識為每筆超標事件補上車牌；CODiS 的天候資料作為事件審核的證據，審核人員在事件審核 API 判定有效或無效；審核後的事件進入稽核儀表板，並交給既有 C# 程式產出稽查紀錄工作單，送交環保單位。",
      site: "路邊站點", site_s: "噪音計 · 風速計 · 攝影機", db: "事件資料庫", db_s: "主庫 · 歷史庫",
      img: "影像辨識", img_s: "影像處理團隊", codis: "CODiS", codis_s: "中央氣象署觀測資料",
      cs: "工作單產生器", cs_s: "既有 C# 程式", gov: "環保單位", gov_s: "稽查與執法決策",
      api: "設備與場域管理 API", api_s: "主檔維護 · 即時監測", wx: "天候查證", wx_s: "爬蟲服務 · Weather AI",
      rev: "事件審核 API", rev_s: "四項條件 → 有效／無效", dash: "稽核儀表板", dash_s: "熱區 · 時段 · 累犯車輛",
      wo: "稽查紀錄工作單", wo_s: "既有 C# 產生器",
      stages: ["量到", "查證", "判定", "看見"],
      mine: "本人負責", others: "其他團隊／外部系統",
      edge: { readings: "量測值", writes: "站點與設備主檔、校正紀錄", events: "事件", verdicts: "判定結果", imagery: "車牌、影像",
              obs: "觀測紀錄", wx: "乾濕、風速、降雨", valid: "有效事件", insight: "洞察", sent: "送交" } };
---

{map === "hytech" && (
  <figure class="system-map" data-focus={area ?? "all"}>
    {area && (
      <div class="system-map-bar">
        <a class="system-map-full mono" href={`${lang_path("/", lang)}#impact-map-title`}>{t("map.full")}</a>
        <p class="system-map-focus"><span class="system-map-key"></span>{t("map.focus")}{area_label}</p>
      </div>
    )}
    <div class="system-map-scroll">
      <svg viewBox={view_box} class:list={{ "is-crop": !overview }} role="img" aria-labelledby={`${uid}-title ${uid}-desc`}>
        <title id={`${uid}-title`}>{svg_text.title}</title>
        <desc id={`${uid}-desc`}>{svg_text.desc}{area && ` ${t("map.focus")}${area_label}`}</desc>

        <!-- Base flow: always visible -->
        <g class="map-base">
          <path class="flow" d="M480 46 V64" />
          <path class="flow" d="M480 104 V142" />
          <path class="arrow" d="M480 150 L475 141 H485 Z" />
          <rect class="node" x="430" y="10" width="100" height="36" rx="18" />
          <text x="480" y="33">Client</text>
          <rect class="node" x="400" y="64" width="160" height="40" rx="6" />
          <text x="480" y="89">Client Portal（Web / APP）</text>
          <rect class="node node-core" x="400" y="150" width="160" height="56" rx="6" />
          <text class="strong" x="480" y="173">CRM</text>
          <text class="small" x="480" y="192">Deposit / WD Audit</text>
        </g>

        <!-- Credit Card Anomaly Detection: Payabl <-> Bridger <-> CRM; Recharge = card deposit, Refunded = card withdrawal -->
        <g class:list={["area", { "is-building": building.includes("credit-card") }]} data-area="credit-card" data-accent={accents["credit-card"]}>
          {overview && <text class="map-tag" x={tag_at["credit-card"].x} y={tag_at["credit-card"].y}>{tags["credit-card"]}</text>}
          <path class="flow" d="M400 84 H180 V120" />
          <path class="arrow" d="M180 128 L175 119 H185 Z" />
          <path class="flow" d="M210 170 H258" />
          <path class="arrow" d="M266 170 L257 165 V175 Z" />
          <path class="flow" d="M266 188 H218" />
          <path class="arrow" d="M210 188 L219 183 V193 Z" />
          <path class="flow" d="M354 170 H392" />
          <path class="arrow" d="M400 170 L391 165 V175 Z" />
          <path class="flow" d="M400 188 H362" />
          <path class="arrow" d="M354 188 L363 183 V193 Z" />
          <text class="tiny" x="238" y="163">Recharge</text>
          <text class="tiny" x="238" y="203">Refunded</text>
          <rect class="node" x="40" y="128" width="170" height="100" rx="6" />
          <text class="strong" x="125" y="158">Credit Card Payabl</text>
          <text class="small" x="125" y="182">Worldpay</text>
          <text class="small" x="125" y="200">Checkout</text>
          <rect class="node node-core" x="266" y="150" width="88" height="56" rx="28" />
          <text class="strong" x="310" y="173">Bridger</text>
          <text class="small" x="310" y="192">PSP trx ID</text>
        </g>

        <!-- Deposit & Withdrawal Drop-Order Monitor: CRM <-> CPS -> channels -->
        <g class:list={["area", { "is-building": building.includes("drop-order") }]} data-area="drop-order" data-accent={accents["drop-order"]}>
          {overview && <text class="map-tag" x={tag_at["drop-order"].x} y={tag_at["drop-order"].y}>{tags["drop-order"]}</text>}
          <path class="flow" d="M560 84 H680 V142" />
          <path class="arrow" d="M680 150 L675 141 H685 Z" />
          <path class="flow" d="M620 170 H568" />
          <path class="arrow" d="M560 170 L569 165 V175 Z" />
          <path class="flow" d="M560 188 H612" />
          <path class="arrow" d="M620 188 L611 183 V193 Z" />
          <text class="tiny" x="590" y="163">Deposit</text>
          <text class="tiny" x="590" y="203">Withdraw</text>
          <rect class="node node-core" x="620" y="150" width="120" height="56" rx="28" />
          <text class="strong" x="680" y="173">CPS</text>
          <text class="small" x="680" y="192">{svg_text.serial}</text>
          <path class="flow" d="M740 178 L790 34" />
          <path class="flow" d="M740 178 L790 92" />
          <path class="flow" d="M740 178 L790 150" />
          <path class="flow" d="M740 178 L790 208" />
          <path class="flow" d="M740 178 L790 266" />
          <rect class="node" x="790" y="10" width="160" height="48" rx="6" />
          <text class="strong" x="870" y="30">Local Bank</text>
          <text class="small" x="870" y="48">Offline · Xpay · Zota</text>
          <rect class="node" x="790" y="68" width="160" height="48" rx="6" />
          <text class="strong" x="870" y="88">Credit Card PSP</text>
          <text class="small" x="870" y="106">Googlepay · Applepay</text>
          <rect class="node" x="790" y="126" width="160" height="48" rx="6" />
          <text class="strong" x="870" y="146">E-wallet</text>
          <text class="small" x="870" y="164">Skrill · Neteller · Paypal</text>
          <rect class="node" x="790" y="184" width="160" height="48" rx="6" />
          <text class="strong" x="870" y="204">Cryptocurrency</text>
          <text class="small" x="870" y="222">USDT · USDC · ETH</text>
          <rect class="node" x="790" y="242" width="160" height="48" rx="6" />
          <text class="strong" x="870" y="271">International Bank</text>
        </g>

        <!-- Account Operation Automation Engine: CRM account <-> MetaTrader -->
        <g class:list={["area", { "is-building": building.includes("account") }]} data-area="account" data-accent={accents["account"]}>
          {overview && <text class="map-tag" x={tag_at["account"].x} y={tag_at["account"].y}>{tags["account"]}</text>}
          <path class="flow" d="M480 206 V246" />
          <path class="flow" d="M480 286 V316" />
          <rect class="node" x="420" y="246" width="120" height="40" rx="6" />
          <text class="strong" x="480" y="271">MetaTrader</text>
          <rect class="node node-core" x="400" y="316" width="160" height="40" rx="6" />
          <text class="small" x="480" y="341">CRM Trading History · Ticket</text>
          <path class="flow" d="M540 276 H590" />
          <rect class="node" x="598" y="250" width="150" height="40" rx="6" />
          <rect class="node" x="590" y="258" width="150" height="40" rx="6" />
          <text class="strong" x="665" y="276">{svg_text.backoffice}</text>
          <text class="small" x="665" y="291">{svg_text.per_reg}</text>
        </g>

        <!-- OP Ticket Data Pipeline: Freshservice tickets -> yearly SQLite -> OP; OP dispatches to and closes out from these groups -->
        <g class:list={["area", { "is-building": building.includes("ticket") }]} data-area="ticket" data-accent={accents["ticket"]}>
          {overview && <text class="map-tag" x={tag_at["ticket"].x} y={tag_at["ticket"].y}>{tags["ticket"]}</text>}
          <path class="flow" d="M210 278 H242" />
          <path class="arrow" d="M250 278 L241 273 V283 Z" />
          <path class="flow" d="M125 306 V330" />
          <rect class="node" x="40" y="250" width="170" height="56" rx="6" />
          <text class="strong" x="125" y="273">Freshservice</text>
          <text class="small" x="125" y="292">Tickets · Conversations</text>
          <rect class="node node-core" x="250" y="250" width="135" height="56" rx="6" />
          <text class="strong" x="317" y="273">Ticket Pipeline</text>
          <text class="small" x="317" y="292">{svg_text.mart}</text>
          <rect class="node node-layer" x="40" y="330" width="345" height="144" rx="6" />
          <text class="strong" x="212" y="351">{svg_text.groups}</text>
          <path class="flow" d="M385 420 H420" />
          <rect class="node" x="420" y="392" width="190" height="56" rx="6" />
          <text class="strong" x="515" y="414">{svg_text.other}</text>
          <text class="small" x="515" y="433">{svg_text.dispatch} · {svg_text.not_yet}</text>
          <text class="tiny" x="128" y="372">(OP)Acc-Account Owner Transfer</text>
          <text class="tiny" x="298" y="372">(OP)Withdrawal Team</text>
          <text class="tiny" x="128" y="385">(OP)Deposit Team</text>
          <text class="tiny" x="298" y="385">(OP)Acc-ID/POA</text>
          <text class="tiny" x="128" y="398">(OP)Acc-CS</text>
          <text class="tiny" x="298" y="398">(OP)Account Team</text>
          <text class="tiny" x="128" y="411">(OP)Acc-IB Adjustment</text>
          <text class="tiny" x="298" y="411">(OP)Acc-QC Ranger</text>
          <text class="tiny" x="128" y="424">(OP)Cpa-AC team</text>
          <text class="tiny" x="298" y="424">(OP)Acc-New IB</text>
          <text class="tiny" x="128" y="437">(OP)FCA-Tickets</text>
          <text class="tiny" x="298" y="437">(OP)Cpa-Payment team</text>
          <text class="tiny" x="128" y="450">(OP) ASIC - Account Team</text>
          <text class="tiny" x="298" y="450">(OP) ASIC - Withdraw Team</text>
          <text class="tiny" x="128" y="463">(OP) ASIC - Deposit Team</text>
        </g>
      </svg>
    </div>
  </figure>
)}


{map === "weishuo" && (
  <figure class="system-map" data-focus={area ?? "all"}>
    {area && (
      <div class="system-map-bar">
        <a class="system-map-full mono" href={`${lang_path("/", lang)}#impact-map-title`}>{t("map.full")}</a>
        <p class="system-map-focus"><span class="system-map-key"></span>{t("map.focus")}{area_label}</p>
      </div>
    )}
    <div class="system-map-scroll">
      <svg viewBox={view_box} role="img" aria-labelledby={`${uid}-title ${uid}-desc`}>
        <title id={`${uid}-title`}>{ws.title}</title>
        <desc id={`${uid}-desc`}>{ws.desc}{area && ` ${t("map.focus")}${area_label}`}</desc>

        <!-- Base: parts owned by others, always visible -->
        <g class="map-base">
          <rect class="node" x="30" y="160" width="140" height="50" rx="6" />
          <text class="strong" x="100" y="181">{ws.site}</text>
          <text class="small" x="100" y="199">{ws.site_s}</text>
          <rect class="node node-store" x="400" y="160" width="140" height="50" rx="25" />
          <text class="strong" x="470" y="181">{ws.db}</text>
          <text class="small" x="470" y="199">{ws.db_s}</text>
          <path class="flow" d="M170 185 H392" /><path class="arrow" d="M400 185 L391 180 V190 Z" />
          <text class="edge" x="285" y="177">{ws.edge.readings}</text>
          <rect class="node" x="430" y="76" width="140" height="44" rx="6" />
          <text class="strong" x="500" y="94">{ws.img}</text>
          <text class="small" x="500" y="111">{ws.img_s}</text>
          <path class="flow" d="M510 120 V152" /><path class="arrow" d="M510 160 L505 151 H515 Z" />
          <text class="edge edge-r" x="517" y="142">{ws.edge.imagery}</text>
          <rect class="node" x="585" y="4" width="140" height="40" rx="6" />
          <text class="strong" x="655" y="21">{ws.codis}</text>
          <text class="small" x="655" y="37">{ws.codis_s}</text>
          <rect class="node" x="585" y="266" width="140" height="50" rx="6" />
          <text class="strong" x="655" y="287">{ws.wo}</text>
          <text class="small" x="655" y="305">{ws.wo_s}</text>
          <rect class="node" x="770" y="266" width="140" height="50" rx="25" />
          <text class="strong" x="840" y="287">{ws.gov}</text>
          <text class="small" x="840" y="305">{ws.gov_s}</text>
          <path class="flow" d="M725 291 H762" /><path class="arrow" d="M770 291 L761 286 V296 Z" />
          <text class="edge" x="745" y="283">{ws.edge.sent}</text>
          <rect class="legend-other" x="30" y="298" width="14" height="10" rx="2" />
          <text class="legend" x="50" y="307">{ws.others}</text>
        </g>

        <!-- Peter's four services on the spine; connectors carry what flows through them -->
        <g class:list={["area", { "is-building": building.includes("noise-enforcement") }]} data-area="noise-enforcement" data-accent={accents["noise-enforcement"]}>
          <rect class="node node-core" x="215" y="76" width="160" height="44" rx="6" />
          <text class="strong" x="295" y="94">{ws.api}</text>
          <text class="small" x="295" y="111">{ws.api_s}</text>
          <text class="stage-kicker" x="215" y="68">{ws.stages[0]}</text>
          <path class="flow" d="M375 98 H420 V152" /><path class="arrow" d="M420 160 L415 151 H425 Z" />
          <text class="edge edge-end" x="414" y="142">{ws.edge.writes}</text>

          <path class="flow" d="M655 44 V68" /><path class="arrow" d="M655 76 L650 67 H660 Z" />
          <text class="edge edge-r" x="662" y="62">{ws.edge.obs}</text>
          <rect class="node node-core" x="585" y="76" width="140" height="44" rx="6" />
          <text class="strong" x="655" y="94">{ws.wx}</text>
          <text class="small" x="655" y="111">{ws.wx_s}</text>
          <text class="stage-kicker" x="735" y="102">{ws.stages[1]}</text>
          <path class="flow" d="M655 120 V152" /><path class="arrow" d="M655 160 L650 151 H660 Z" />
          <text class="edge edge-r" x="662" y="142">{ws.edge.wx}</text>

          <path class="flow" d="M540 185 H577" /><path class="arrow" d="M585 185 L576 180 V190 Z" />
          <text class="edge" x="562" y="177">{ws.edge.events}</text>
          <rect class="node node-core" x="585" y="160" width="140" height="50" rx="25" />
          <text class="strong" x="655" y="181">{ws.rev}</text>
          <text class="small" x="655" y="199">{ws.rev_s}</text>
          <text class="stage-kicker" x="585" y="232">{ws.stages[2]}</text>
          <path class="flow" d="M655 210 V258" /><path class="arrow" d="M655 266 L650 257 H660 Z" />
          <text class="edge edge-r" x="662" y="244">{ws.edge.valid}</text>

          <path class="flow" d="M725 185 H762" /><path class="arrow" d="M770 185 L761 180 V190 Z" />
          <text class="edge" x="747" y="177">{ws.edge.verdicts}</text>
          <rect class="node node-core" x="770" y="160" width="140" height="50" rx="6" />
          <text class="strong" x="840" y="181">{ws.dash}</text>
          <text class="small" x="840" y="199">{ws.dash_s}</text>
          <text class="stage-kicker" x="770" y="152">{ws.stages[3]}</text>
          <path class="flow" d="M840 210 V258" /><path class="arrow" d="M840 266 L835 257 H845 Z" />
          <text class="edge edge-r" x="847" y="244">{ws.edge.insight}</text>

          <rect class="legend-mine" x="30" y="280" width="14" height="10" rx="2" />
          <text class="legend" x="50" y="289">{ws.mine}</text>
        </g>
      </svg>
    </div>
  </figure>
)}

<script>
  // On narrow screens the map scrolls sideways; start with the highlighted area in view.
  // Without JS the map is still complete and can be scrolled by hand.
  for (const fig of document.querySelectorAll<HTMLElement>(".system-map[data-focus]:not([data-focus='all'])")) {
    const scroller = fig.querySelector<HTMLElement>(".system-map-scroll");
    const area     = fig.querySelector<SVGGraphicsElement>(`.area[data-area="${fig.dataset.focus}"]`);
    const svg      = fig.querySelector<SVGSVGElement>("svg");
    if (!scroller || !area || !svg || scroller.scrollWidth <= scroller.clientWidth) continue;
    const box    = area.getBBox();
    const scale  = svg.getBoundingClientRect().width / svg.viewBox.baseVal.width;
    const center = (box.x + box.width / 2) * scale;
    scroller.scrollLeft = Math.max(0, center - scroller.clientWidth / 2);
  }
</script>
