---
// Photo framed in an organic blob with dots; used on Home and Contact.
import { profile } from "../data/profile";
import type { Lang } from "../i18n/ui";
import { url } from "../lib/url";

interface Props { lang?: Lang; }
const { lang = "zh" } = Astro.props;
const alt = lang === "en" ? `Photo of ${profile.name}` : `${profile.name} 的照片`;
---

<div class="hero-photo">
  <span class="hero-blob" aria-hidden="true"></span>
  <img src={url("media/peter-photo.jpg")} alt={alt} width="560" height="716" />
  <span class="hero-dots" aria-hidden="true"><i></i><i></i><i></i></span>
</div>
